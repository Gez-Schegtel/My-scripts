#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

# ==============================================================================
# SCRIPT: discord-canary-updater
# DESCRIPCIÓN:
#   Descarga e instala automáticamente la última versión de Discord Canary
#   (.deb). Es un atajo a "discord-updater --canary": todo el trabajo lo hace
#   discord-updater, que está en la misma carpeta (así hay una sola copia del
#   código y cualquier arreglo vale para las dos versiones).
#
# USO:
#   discord-canary-updater
#   discord-canary-updater --help   (-h o --help: muestra la ayuda)
#
# CÓDIGO DE SALIDA y DEPENDENCIAS: los de discord-updater.
# ==============================================================================

# Se ejecuta discord-updater desde la carpeta real de este script, aunque se
# lo llame a través del enlace de /usr/local/bin.
exec "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/discord-updater" --canary "$@"
