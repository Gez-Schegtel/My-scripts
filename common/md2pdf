#!/usr/bin/env zsh

# ==============================================================================
# SCRIPT: md2pdf
# DESCRIPCIÓN:
#   Convierte archivos Markdown (.md) a PDF con pandoc, usando mi configuración
#   de estilo ("pandoc -d estilo"). Es lo mismo que escribir a mano
#       pandoc -d estilo nota.md -o nota.pdf
#   pero para varios archivos a la vez y con confirmación.
#
#   El script NO define ningún aspecto del PDF (motor, fuentes, emojis, cuadros,
#   márgenes...). Todo eso vive en el repositorio "Pandoc config", que es la
#   carpeta de datos de pandoc (~/.local/share/pandoc):
#       defaults/estilo.yaml     opciones de pandoc (el que se nombra con -d)
#       defaults/metadatos.yaml  idioma, márgenes, tamaño de letra
#       defaults/estilo.tex      aspecto en LaTeX
#       filters/                 filtros de pandoc que usa el estilo
#   Para cambiar cómo se ven los PDF se edita ese repositorio, no este script.
#   Cada nota solo necesita su cabecera (title, author, date...) y puede
#   cambiar un valor poniéndolo ahí (por ejemplo, geometry: margin=4cm).
#
#   Cómo funciona:
#     1. Arma la lista de archivos: los que se pasan como argumento o, si no se
#        pasa ninguno, todos los .md de la carpeta actual.
#     2. Los muestra y pide confirmación.
#     3. Ejecuta pandoc una vez por archivo. El PDF se guarda al lado del .md
#        con el mismo nombre (nota.md -> nota.pdf). Las imágenes se buscan
#        primero en la carpeta del .md, así funciona aunque lo ejecutes desde
#        otra carpeta.
#     4. Si un archivo falla, sigue con los demás y al final informa cuáles
#        no se pudieron convertir.
#
# USO:
#   md2pdf                    (Detecta y convierte todos los .md de la carpeta)
#   md2pdf archivo.md         (Convierte solo un archivo específico)
#   md2pdf apunte1.md apunte2.md
#   md2pdf ~/notas/*.md       (Los archivos pueden estar en cualquier carpeta)
#
# NOTAS DE OBSIDIAN:
#   Si un .md tiene sintaxis de Obsidian ([[...]]), antes de pasarlo a pandoc
#   se traduce a Markdown estándar en una copia temporal (el .md no se toca):
#       ![[foto.png]]         ->  la imagen
#       ![[foto.png|400]]     ->  la imagen con 400 px de ancho
#       ![[foto.png|derecha]] ->  la imagen pegada a la derecha ("izquierda"
#                                 también vale; se puede combinar: |derecha|300)
#   Sin alineación, las imágenes salen centradas en el PDF. En Obsidian las
#   palabras "izquierda" y "derecha" son solo texto alternativo: no se ven.
#       [[Nota]]              ->  Nota          (texto, sin enlace)
#       [[Nota|otro texto]]   ->  otro texto
#   La imagen se busca, en este orden: en la carpeta del .md (o la ruta escrita,
#   si tiene carpeta), y después por nombre en todo el vault (la carpeta que
#   tiene .obsidian/). Si no hay vault, en todo el repositorio git del .md; y
#   si tampoco hay, en la carpeta del .md y sus subcarpetas.
#   Dentro de bloques de código y de `código en línea` no se cambia nada.
#   Los .md sin [[ ]] pasan directo a pandoc, sin ninguna traducción.
#
# CÓDIGO DE SALIDA:
#   0 si todo se convirtió (o si cancelaste), 1 si algún archivo falló o si
#   falta alguna dependencia o la configuración de estilo.
#
# DEPENDENCIAS REQUERIDAS:
#   - zsh (El script está escrito específicamente para Z shell)
#   - pandoc y lualatex, con los paquetes de LaTeX y las fuentes que usa el
#     estilo (la lista completa está en el README del repositorio Pandoc config)
#   - El repositorio Pandoc config instalado en la carpeta de datos de pandoc
#     (para comprobarlo: pandoc --version | grep -i "user data")
#   - perl, solo para las notas de Obsidian (viene instalado en Debian/Ubuntu).
#     git es opcional: si está, se usa para encontrar la raíz del repositorio.
#
# Instalación de dependencias en Debian/Ubuntu:
#   sudo apt install zsh pandoc texlive-luatex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended lmodern fonts-noto-color-emoji
# ==============================================================================

# extended_glob: permite el patrón *.(#i)(md|markdown)(N.) de más abajo.
setopt extended_glob

# --- Comprobaciones previas ---------------------------------------------------
# Se hacen antes de pedir nada, para fallar una sola vez y con un mensaje claro
# (si no, cada archivo fallaría por separado con el mismo error).

if (( ! $+commands[pandoc] )); then
  echo "❌ Error: pandoc no está instalado. Instalalo con:"
  echo "   sudo apt install pandoc texlive-luatex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended lmodern fonts-noto-color-emoji"
  exit 1
fi

if (( ! $+commands[lualatex] )); then
  echo "❌ Error: lualatex no está instalado (lo usa el estilo de los PDF). Instalalo con:"
  echo "   sudo apt install texlive-luatex"
  exit 1
fi

# Se comprueba que "-d estilo" se pueda cargar: convierte un texto vacío a texto
# plano (no genera ningún PDF). Falla si pandoc no encuentra defaults/estilo.yaml
# en su carpeta de datos o si ese archivo apunta a otro que no existe.
if ! echo "" | pandoc -d estilo -t plain -o /dev/null 2>/dev/null; then
  echo "❌ Error: pandoc no pudo cargar la configuración de estilo (-d estilo)."
  echo "   Tiene que existir defaults/estilo.yaml dentro de la carpeta de datos de"
  echo "   pandoc. Para ver cuál es esa carpeta:"
  echo "     pandoc --version | grep -i \"user data\""
  echo "   Tiene que ser ~/.local/share/pandoc. Si muestra ~/.pandoc, es porque"
  echo "   ~/.local/share/pandoc no existe (pandoc usa la carpeta vieja solo en"
  echo "   ese caso)."
  exit 1
fi

# --- 1. Construimos la lista de archivos a convertir --------------------------
archivos=()

if (( $# > 0 )); then
  # Si pasaste archivos por argumento: md2pdf a.md b.md
  for archivo in "$@"; do
    if [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
    elif [[ "${(L)archivo:e}" != (md|markdown) ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo Markdown (.md)."
    else
      archivos+=("$archivo")
    fi
  done
else
  # Si no pasaste nada: todos los .md del directorio (también .MD o .markdown).
  # (#i) ignora mayúsculas, (N) no da error si no hay ninguno, (.) solo archivos.
  archivos=( *.(#i)(md|markdown)(N.) )
fi

# --- 2. Si no hay archivos, salimos -------------------------------------------
if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos Markdown para convertir."
  exit 0
fi

# --- 3. Mostrar qué se va a convertir (el PDF reemplaza la extensión .md) -----
echo "Se van a convertir los siguientes archivos:"
for archivo in "${archivos[@]}"; do
  echo "  - $archivo -> ${archivo:r}.pdf"
done

# --- 4. Pedir confirmación ----------------------------------------------------
read "respuesta?¿Continuar? [s/N]: "
case "$respuesta" in
  s|S|y|Y)
    echo "Iniciando conversión..."
    ;;
  *)
    echo "Operación cancelada."
    exit 0
    ;;
esac

# --- Traducción de la sintaxis de Obsidian -----------------------------------
# Solo se usa con los .md que tienen [[ ]] (ver "NOTAS DE OBSIDIAN" arriba).

# Carpeta donde buscar imágenes por nombre: el vault de Obsidian (la carpeta
# que contiene .obsidian/), si no el repositorio git, si no la carpeta del .md.
carpeta_de_busqueda() {
  local carpeta=${1:A} d=${1:A} raiz
  while [[ $d != / ]]; do
    [[ -d $d/.obsidian ]] && { print -r -- $d; return }
    d=${d:h}
  done
  if raiz=$(git -C "$carpeta" rev-parse --show-toplevel 2>/dev/null); then
    print -r -- $raiz
  else
    print -r -- $carpeta
  fi
}

# Programa en perl que hace la traducción. Lee el .md y escribe el resultado.
# Variables que recibe: CARPETA_MD (carpeta del .md) y BASE (dónde buscar).
read -r -d '' TRADUCIR_OBSIDIAN <<'PERL'
use strict; use warnings; use utf8;
use File::Find; use File::Basename qw(basename);
use Encode qw(encode decode);
# Las rutas se manejan como texto (decodificado) y se codifican en UTF-8 solo
# al preguntarle algo al sistema de archivos, para que anden acentos y eñes.
sub fs  { encode("UTF-8", $_[0]) }
sub txt { decode("UTF-8", $_[0]) }
my $carpeta = txt($ENV{CARPETA_MD});
my $base    = txt($ENV{BASE});
my %indice;   # nombre de archivo -> rutas encontradas (se arma al necesitarlo)
my $indexado = 0;

sub buscar {
  my ($ruta) = @_;
  return "$carpeta/$ruta" if -f fs("$carpeta/$ruta");
  return "$base/$ruta"    if -f fs("$base/$ruta");
  if (!$indexado) {
    my $raiz = fs($base);
    find({ no_chdir => 1, wanted => sub {
      if (-d $_ && basename($_) =~ /^\./ && $_ ne $raiz) { $File::Find::prune = 1; return; }
      if (-f $_) { my $r = txt($_); push @{ $indice{basename($r)} }, $r; }
    } }, $raiz);
    $indexado = 1;
  }
  my @c = @{ $indice{basename($ruta)} || [] };
  my $fin = "/$ruta";                               # si se escribió carpeta/foto.png
  my @exactos = grep { substr($_, -length($fin)) eq $fin } @c;
  @c = @exactos if @exactos;
  return undef unless @c;
  return (sort { length($a) <=> length($b) || $a cmp $b } @c)[0];  # la más cercana
}

sub traducir {
  my ($embebido, $dentro) = @_;
  my ($destino, $extra) = split /\|/, $dentro, 2;
  $destino =~ s/\\$//;            # en tablas Obsidian escribe \| en vez de |
  $destino =~ s/^\s+|\s+$//g;
  my ($sin_seccion) = split /#/, $destino, 2;
  if ($embebido && $sin_seccion =~ /\.(png|jpe?g|gif|bmp|webp|svg|pdf)$/i) {
    my $ruta = buscar($sin_seccion);
    if (!defined $ruta) {
      warn "⚠️  No encontré la imagen: $sin_seccion\n";
      return "[imagen no encontrada: $sin_seccion]";
    }
    # Después del primer | puede haber un ancho (400), una alineación
    # (izquierda / derecha) o ambos, en cualquier orden: |derecha|300
    my @attr;
    if (defined $extra) {
      for my $t (split /\|/, $extra) {
        $t =~ s/\\$//; $t =~ s/^\s+|\s+$//g;
        if    ($t =~ /^(\d+)/)               { push @attr, "width=$1px" unless grep { /^width=/ } @attr; }
        elsif (lc $t eq 'izquierda')          { push @attr, ".izquierda" unless grep { /^\.(izquierda|derecha)$/ } @attr; }
        elsif (lc $t eq 'derecha')            { push @attr, ".derecha"   unless grep { /^\.(izquierda|derecha)$/ } @attr; }
      }
    }
    my $atributos = @attr ? "{" . join(" ", @attr) . "}" : "";
    return "![](<$ruta>)$atributos";
  }
  # Enlace a otra nota (o nota embebida): queda el texto
  return (defined $extra && $extra ne "") ? $extra : $destino;
}

my $en_codigo = 0;
while (my $linea = <STDIN>) {
  if ($linea =~ /^\s*(```|~~~)/) { $en_codigo = !$en_codigo; print $linea; next; }
  if ($en_codigo) { print $linea; next; }
  # `código` se deja igual; ![[...]] y [[...]] se traducen
  $linea =~ s{(`+)(.*?)\1|(!?)\[\[([^\[\]\n]+?)\]\]}{
    defined $1 ? "$1$2$1" : traducir($3 eq "!", $4)
  }ge;
  print $linea;
}
PERL

# --- 5. Ejecutar pandoc y mostrar mensajes por archivo ------------------------
# Si uno falla, se sigue con los demás. "--" va antes del archivo por si algún
# nombre empieza con "-" (si no, pandoc lo tomaría por una opción).
#
# --resource-path: carpetas donde pandoc busca las imágenes (separadas por ":").
# Por defecto busca solo en la carpeta desde donde se ejecuta el comando, así
# que "md2pdf ~/notas/apunte.md" desde otra carpeta perdía las imágenes de
# ~/notas. ${archivo:h} es la carpeta del .md; después se prueba la actual.
#
# Si el .md tiene sintaxis de Obsidian, pandoc lee una copia traducida (en una
# carpeta temporal); las imágenes normales se siguen buscando en la carpeta
# del .md gracias a --resource-path.
fallidos=()
for archivo in "${archivos[@]}"; do
  salida="${archivo:r}.pdf"
  entrada="$archivo"
  temporal=""
  if grep -q '\[\[' -- "$archivo"; then
    temporal="$(mktemp --suffix=.md)"
    if ! CARPETA_MD="${archivo:h:A}" BASE="$(carpeta_de_busqueda "${archivo:h}")" \
         perl -CSD -e "$TRADUCIR_OBSIDIAN" < "$archivo" > "$temporal"; then
      echo "❌ Error al traducir la sintaxis de Obsidian: $archivo"
      fallidos+=("$archivo"); rm -f "$temporal"; continue
    fi
    entrada="$temporal"
  fi
  if pandoc -d estilo --resource-path="${archivo:h}:." --output="$salida" -- "$entrada"; then
    echo "✔ Generado: $salida"
  else
    echo "❌ Error al convertir: $archivo"
    fallidos+=("$archivo")
  fi
  [[ -n $temporal ]] && rm -f "$temporal"
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ No se pudieron convertir ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
  exit 1
fi
echo "✅ Conversión completa."
