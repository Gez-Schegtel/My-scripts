#!/usr/bin/env zsh
# SPDX-License-Identifier: GPL-3.0-or-later

# ==============================================================================
# SCRIPT: md2pdf
# DESCRIPCIÓN:
#   Convierte archivos Markdown (.md) a PDF con pandoc, usando mi configuración
#   de estilo ("pandoc -d estilo"). Es lo mismo que escribir a mano
#       pandoc -d estilo nota.md -o nota.pdf
#   pero para varios archivos a la vez y con confirmación.
#
#   El script NO define ningún aspecto del PDF (motor, fuentes, emojis, cuadros,
#   márgenes...). Todo eso vive en el repositorio "Pandoc config", que es la
#   carpeta de datos de pandoc (~/.local/share/pandoc):
#       defaults/estilo.yaml     opciones de pandoc (el que se nombra con -d)
#       defaults/metadatos.yaml  idioma, márgenes, tamaño de letra
#       defaults/estilo.tex      aspecto en LaTeX
#       filters/                 filtros de pandoc que usa el estilo
#   Para cambiar cómo se ven los PDF se edita ese repositorio, no este script.
#   Cada nota solo necesita su cabecera (title, author, date...) y puede
#   cambiar un valor poniéndolo ahí (por ejemplo, geometry: margin=4cm).
#
#   Cómo funciona:
#     1. Arma la lista de archivos: los que se pasan como argumento o, si no se
#        pasa ninguno, todos los .md de la carpeta actual.
#     2. Los muestra y pide confirmación (y o ENTER aceptan; cualquier otra
#        respuesta cancela). Con -y no pregunta.
#     3. Ejecuta pandoc una vez por archivo. El PDF se guarda al lado del .md
#        con el mismo nombre (nota.md -> nota.pdf). Las imágenes se buscan
#        primero en la carpeta del .md, así funciona aunque lo ejecutes desde
#        otra carpeta, y después en las carpetas que pases con -i.
#     4. Si un archivo falla, sigue con los demás y al final informa cuáles
#        no se pudieron convertir.
#
# USO:
#   md2pdf                    (Detecta y convierte todos los .md de la carpeta)
#   md2pdf archivo.md         (Convierte solo un archivo específico)
#   md2pdf apunte1.md apunte2.md
#   md2pdf ~/notas/*.md       (Los archivos pueden estar en cualquier carpeta)
#   md2pdf -y archivo.md      (-y o --yes: convierte sin pedir confirmación;
#                              va con cualquiera de las formas de arriba)
#   md2pdf -i ~/imagenes archivo.md
#                             (-i o --imagenes: otra carpeta donde buscar las
#                              imágenes, también en sus subcarpetas. Se puede
#                              repetir: -i una -i otra. Sirve cuando las
#                              imágenes no están al lado del .md ni dentro del
#                              vault o repositorio de la nota)
#
# SINTAXIS QUE PANDOC NO ENTIENDE (Obsidian, GitHub, Notion...):
#   Si un .md tiene enlaces [[...]], imágenes o avisos > [!NOTE], antes de
#   pasarlo a pandoc se traduce en una copia temporal (el .md no se toca):
#       ![[foto.png]]         ->  la imagen
#       ![[foto.png|400]]     ->  la imagen con 400 px de ancho
#       ![[foto.png|derecha]] ->  la imagen pegada a la derecha ("izquierda"
#                                 también vale; se puede combinar: |derecha|300)
#   Sin alineación, las imágenes salen centradas en el PDF. En Obsidian las
#   palabras "izquierda" y "derecha" son solo texto alternativo: no se ven.
#       [[Nota]]              ->  Nota          (texto, sin enlace)
#       [[Nota|otro texto]]   ->  otro texto
#   La imagen se busca, en este orden: en la carpeta del .md (o la ruta escrita,
#   si tiene carpeta); en las carpetas de -i, si pasaste alguna (también por
#   nombre en sus subcarpetas); y después por nombre en todo el vault (la
#   carpeta que tiene .obsidian/). Si no hay vault, en todo el repositorio git
#   del .md; y si tampoco hay, en la carpeta del .md, sus subcarpetas y las
#   carpetas hermanas (las que están al lado, dentro de la misma carpeta) con
#   sus subcarpetas, salvo que la carpeta de arriba sea tu carpeta personal o /
#   (para no recorrer todo el disco). Si hay varias con el mismo nombre, usa
#   la más cercana a la nota.
#   Lo mismo vale para las imágenes de Markdown estándar, ![texto](foto.png),
#   que es lo que Obsidian escribe si desactivás los wikilinks (con %20 en vez
#   de espacios): si el archivo no está donde dice la ruta, se busca por nombre
#   en el vault. Si la ruta existe tal cual, no se toca nada.
#   Si el texto de una imagen es solo el nombre del archivo
#   (![image.png](...), como exporta Notion), no se usa: pandoc lo pondría de
#   epígrafe. Los acentos de la ruta se aceptan escritos de las dos formas
#   que existen en Unicode (las exportaciones de Notion a veces usan la otra).
#   Avisos de GitHub y callouts de Obsidian:
#       > [!NOTE]             ->  > **Nota**   (el tipo, traducido)
#       > [!tip] Mi título    ->  > **Mi título**
#   Letras matemáticas Unicode (𝐴, 𝑓, 𝑥, 𝛼 en U+1D400..U+1D7FF):
#       𝐴 + 𝑓(𝑥)              ->  A + f(x)     (normalización NFKC)
#   Evita errores de caracteres faltantes en LaTeX al copiar fórmulas de IA.
#   Dentro de bloques de código y de `código en línea` no se cambia nada.
#   Listas pegadas al texto de arriba: pandoc no las reconoce sin una línea
#   en blanco antes y salen como parte del párrafo. Se agrega esa línea
#   antes del primer ítem (con la misma regla que mdnorm: viñeta o número de
#   hasta 3 cifras, así un año como "1816." al principio de un renglón no
#   se toma como lista). La cabecera YAML no se toca. Un ítem con sangría
#   (una tabulación o 4 espacios) pegado al párrafo pasa al margen con su
#   lista (con esa sangría y la línea en blanco sería un bloque de código),
#   y los bloques de código con sangría no se tocan.
#   Si no hay nada que traducir, pandoc lee el .md original, sin copia.
#
# CÓDIGO DE SALIDA:
#   0 si todo se convirtió (o si cancelaste), 1 si algún archivo falló, si
#   alguno de los que pasaste no existe o no es un .md, o si falta alguna
#   dependencia o la configuración de estilo.
#
# ARCHIVOS QUE NO ESTÁN EN UTF-8:
#   Un .md en otra codificación (por ejemplo Latin-1, de un editor viejo de
#   Windows) se convierte igual, pero sin traducir la sintaxis de Obsidian,
#   y se avisa cómo pasarlo a UTF-8 con iconv.
#
# DEPENDENCIAS REQUERIDAS:
#   - zsh (El script está escrito específicamente para Z shell)
#   - pandoc y lualatex, con los paquetes de LaTeX y las fuentes que usa el
#     estilo (la lista completa está en el README del repositorio Pandoc config)
#   - El repositorio Pandoc config instalado en la carpeta de datos de pandoc
#     (para comprobarlo: pandoc --version | grep -i "user data")
#   - cmp (paquete diffutils, viene instalado), para ver si la copia
#     traducida cambió algo, e iconv (paquete libc-bin, viene instalado),
#     para comprobar que el .md esté en UTF-8.
#   - perl, para traducir la sintaxis que pandoc no entiende (viene instalado
#     en Debian/Ubuntu).
#     git es opcional: si está, se usa para encontrar la raíz del repositorio.
#
# Instalación de dependencias en Debian/Ubuntu:
#   sudo apt install zsh pandoc texlive-luatex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended lmodern fonts-noto-color-emoji
# ==============================================================================

# extended_glob: permite el patrón *.(#i)(md|markdown)(N.) de más abajo.
setopt extended_glob

# --- Comprobaciones previas ---------------------------------------------------
# Se hacen antes de pedir nada, para fallar una sola vez y con un mensaje claro
# (si no, cada archivo fallaría por separado con el mismo error).

if (( ! $+commands[pandoc] )); then
  echo "❌ Error: pandoc no está instalado. Instalalo con:"
  echo "   sudo apt install pandoc texlive-luatex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended lmodern fonts-noto-color-emoji"
  exit 1
fi

if (( ! $+commands[lualatex] )); then
  echo "❌ Error: lualatex no está instalado (lo usa el estilo de los PDF). Instalalo con:"
  echo "   sudo apt install texlive-luatex"
  exit 1
fi

# Se comprueba que "-d estilo" se pueda cargar: convierte un texto vacío a texto
# plano (no genera ningún PDF). Falla si pandoc no encuentra defaults/estilo.yaml
# en su carpeta de datos o si ese archivo apunta a otro que no existe.
if ! echo "" | pandoc -d estilo -t plain -o /dev/null 2>/dev/null; then
  echo "❌ Error: pandoc no pudo cargar la configuración de estilo (-d estilo)."
  echo "   Tiene que existir defaults/estilo.yaml dentro de la carpeta de datos de"
  echo "   pandoc. Para ver cuál es esa carpeta:"
  echo "     pandoc --version | grep -i \"user data\""
  echo "   Tiene que ser ~/.local/share/pandoc. Si muestra ~/.pandoc, es porque"
  echo "   ~/.local/share/pandoc no existe (pandoc usa la carpeta vieja solo en"
  echo "   ese caso)."
  exit 1
fi

# --- Opciones -----------------------------------------------------------------
# -y / --yes: no pregunta, convierte directo.
# -i carpeta / --imagenes carpeta: otra carpeta donde buscar las imágenes. Se
#   puede repetir (-i una -i otra).
# zparseopts saca las opciones de los argumentos (-E: en cualquier posición);
# -F falla con una opción que no existe. Un "--" suelto se descarta (se acepta
# por costumbre de otros comandos).
uso="Uso: md2pdf [-y] [-i carpeta_de_imágenes] [archivo.md ...]"
zparseopts -D -E -F -- y=opcion_y -yes=opcion_y \
    i+:=opcion_i -imagenes+:=opcion_i 2>/dev/null || {
  echo "❌ Opción no válida o incompleta. $uso"
  exit 1
}
[[ $1 == -- ]] && shift

# opcion_i queda como pares (-i carpeta -i carpeta ...): se toman las carpetas,
# se comprueba que existan y se pasan a ruta absoluta.
carpetas_imagenes=()
for (( k = 2; k <= $#opcion_i; k += 2 )); do
  carpeta="${opcion_i[k]#=}"      # --imagenes=carpeta deja un "=" adelante
  if [[ ! -d $carpeta ]]; then
    echo "❌ La carpeta de imágenes '$carpeta' no existe. $uso"
    exit 1
  fi
  carpetas_imagenes+=("${carpeta:A}")
done

# --- 1. Construimos la lista de archivos a convertir --------------------------
archivos=()
saltados=0

if (( $# > 0 )); then
  # Si pasaste archivos por argumento: md2pdf a.md b.md
  for archivo in "$@"; do
    if [[ -d "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': es una carpeta, no un archivo."
      (( saltados++ ))
    elif [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
      (( saltados++ ))
    elif [[ "${(L)archivo:e}" != (md|markdown) ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo Markdown (.md)."
      (( saltados++ ))
    else
      archivos+=("$archivo")
    fi
  done
else
  # Si no pasaste nada: todos los .md del directorio (también .MD o .markdown).
  # (#i) ignora mayúsculas, (N) no da error si no hay ninguno, (.) solo archivos.
  archivos=( *.(#i)(md|markdown)(N.) )
fi

# --- 2. Si no hay archivos, salimos -------------------------------------------
# Si pediste archivos y ninguno sirvió, es un error (código 1); si no pediste
# ninguno y en la carpeta no hay .md, no hay nada que hacer (código 0).
if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos Markdown para convertir."
  (( saltados > 0 )) && exit 1
  exit 0
fi

# --- 3. Mostrar qué se va a convertir (el PDF reemplaza la extensión .md) -----
echo "Se van a convertir los siguientes archivos:"
for archivo in "${archivos[@]}"; do
  echo "  - $archivo -> ${archivo:r}.pdf"
done

# --- 4. Pedir confirmación ----------------------------------------------------
# [Y/n]: ENTER solo también acepta. Si no hay dónde leer la respuesta (Ctrl+D,
# o el script corre sin terminal), se cancela en vez de aceptar sin preguntar.
# Con -y se salta la pregunta.
if (( $#opcion_y )); then
  echo "Iniciando conversión..."
else
  read "respuesta?¿Continuar? [Y/n]: " || respuesta=n
  case "$respuesta" in
    y|Y|"")
      echo "Iniciando conversión..."
      ;;
    *)
      echo "Operación cancelada."
      exit 0
      ;;
  esac
fi

# --- Traducción de la sintaxis que pandoc no entiende -------------------------
# Solo se usa con los .md que tienen [[ ]], imágenes o avisos [!...] (ver
# "SINTAXIS QUE PANDOC NO ENTIENDE" arriba).

# Carpeta donde buscar imágenes por nombre: el vault de Obsidian (la carpeta
# que contiene .obsidian/), si no el repositorio git. Si no hay ninguno, la
# carpeta de arriba del .md: así entran la carpeta del .md, sus subcarpetas y
# las carpetas "hermanas" (por ejemplo notas/ y fotos/ dentro de la misma
# carpeta). Pero si la carpeta de arriba es tu carpeta personal o la raíz (/),
# se busca solo en la del .md, para no recorrer todo el disco.
carpeta_de_busqueda() {
  local carpeta=${1:A} d=${1:A} raiz
  while [[ $d != / ]]; do
    [[ -d $d/.obsidian ]] && { print -r -- $d; return }
    d=${d:h}
  done
  if raiz=$(git -C "$carpeta" rev-parse --show-toplevel 2>/dev/null); then
    print -r -- $raiz
  elif [[ ${carpeta:h} == (/|${HOME:A}) ]]; then
    print -r -- $carpeta
  else
    print -r -- ${carpeta:h}
  fi
}

# Programa en perl que hace la traducción. Lee el .md y escribe el resultado.
# Variables que recibe: CARPETA_MD (carpeta del .md) y BASE (dónde buscar).
read -r -d '' TRADUCIR <<'PERL'
use strict; use warnings; use utf8;
use File::Find; use File::Basename qw(basename); use File::Spec;
use Encode qw(encode decode); use Unicode::Normalize qw(NFC NFD NFKC);
# Las rutas se manejan como texto (decodificado) y se codifican en UTF-8 solo
# al preguntarle algo al sistema de archivos, para que anden acentos y eñes.
sub fs  { encode("UTF-8", $_[0]) }
sub txt { decode("UTF-8", $_[0]) }
my $carpeta = txt($ENV{CARPETA_MD});
my $base    = txt($ENV{BASE});
# Carpetas pasadas con -i (una por línea; pueden no venir).
my @extras  = grep { length } split /\n/, txt($ENV{IMAGENES} // "");
my %indices;  # carpeta -> { nombre de archivo -> rutas } (se arma al necesitarlo)

sub indice_de {
  my ($dir) = @_;
  return $indices{$dir} if $indices{$dir};
  my %ind; my $raiz = fs($dir);
  find({ no_chdir => 1, wanted => sub {
    if (-d $_ && basename($_) =~ /^\./ && $_ ne $raiz) { $File::Find::prune = 1; return; }
    if (-f $_) { my $r = txt($_); push @{ $ind{NFC(basename($r))} }, $r; }
  } }, $raiz);
  return $indices{$dir} = \%ind;
}

# Orden: la ruta tal cual desde la carpeta del .md, desde cada carpeta de -i y
# desde el vault; después, por nombre dentro de las carpetas de -i (y sus
# subcarpetas) y por último por nombre en todo el vault.
sub buscar {
  my ($ruta) = @_;
  # Los acentos pueden estar escritos de dos formas ("á" o "a" + tilde, como
  # en algunas exportaciones de Notion): se prueban las dos.
  for my $dir ($carpeta, @extras, $base) {
    for my $v ($ruta, NFC($ruta), NFD($ruta)) {
      return "$dir/$v" if -f fs("$dir/$v");
    }
  }
  my $fin = "/$ruta";                               # si se escribió carpeta/foto.png
  for my $dir (@extras, $base) {
    my @c = @{ indice_de($dir)->{NFC(basename($ruta))} || [] };
    my @exactos = grep { my $n = NFC($_); substr($n, -length($fin)) eq NFC($fin) } @c;
    @c = @exactos if @exactos;
    # Si hay varias con el mismo nombre, la más cercana a la nota: la que está
    # a menos carpetas de distancia (contando las subidas con ..).
    my %dist = map { my $r = File::Spec->abs2rel($_, $carpeta); ($_ => scalar(split m{/}, $r)) } @c;
    return (sort { $dist{$a} <=> $dist{$b} || $a cmp $b } @c)[0] if @c;
  }
  return undef;
}

sub traducir {
  my ($embebido, $dentro) = @_;
  my ($destino, $extra) = split /\|/, $dentro, 2;
  $destino =~ s/\\$//;            # en tablas Obsidian escribe \| en vez de |
  $destino =~ s/^\s+|\s+$//g;
  my ($sin_seccion) = split /#/, $destino, 2;
  if ($embebido && $sin_seccion =~ /\.(png|jpe?g|gif|bmp|webp|svg|pdf)$/i) {
    my $ruta = buscar($sin_seccion);
    if (!defined $ruta) {
      warn "⚠️  No encontré la imagen: $sin_seccion\n";
      return "[imagen no encontrada: $sin_seccion]";
    }
    # Después del primer | puede haber un ancho (400), una alineación
    # (izquierda / derecha) o ambos, en cualquier orden: |derecha|300
    my @attr;
    if (defined $extra) {
      for my $t (split /\|/, $extra) {
        $t =~ s/\\$//; $t =~ s/^\s+|\s+$//g;
        if    ($t =~ /^(\d+)(?:x\d+)?$/)     { push @attr, "width=$1px" unless grep { /^width=/ } @attr; }
        elsif (lc $t eq 'izquierda')          { push @attr, ".izquierda" unless grep { /^\.(izquierda|derecha)$/ } @attr; }
        elsif (lc $t eq 'derecha')            { push @attr, ".derecha"   unless grep { /^\.(izquierda|derecha)$/ } @attr; }
      }
    }
    my $atributos = @attr ? "{" . join(" ", @attr) . "}" : "";
    return "![](<$ruta>)$atributos";
  }
  # Enlace a otra nota (o nota embebida): queda el texto
  return (defined $extra && $extra ne "") ? $extra : $destino;
}

# Imagen de Markdown estándar: ![texto](ruta). Si la ruta existe tal cual (ya
# sea relativa a la carpeta del .md o absoluta), no se toca nada. Si no existe,
# se prueba con los %20 y similares decodificados y se busca el archivo por
# nombre, igual que con ![[...]]. Si se encuentra, se reescribe con la ruta
# completa; si no, queda como estaba (pandoc avisa que no la encontró).
sub imagen_estandar {
  my ($original, $alt, $dest, $titulo) = @_;
  my $d = $dest;
  $d =~ s/^<(.*)>$/$1/;
  return $original if $d =~ m{^(?:[a-zA-Z][a-zA-Z0-9+.\-]*:|/|\#)};   # URL, ruta absoluta
  # %XX son bytes de UTF-8: se decodifican sobre los bytes de la ruta (no sobre
  # el texto), así anda también si la ruta tiene acentos o emojis sin codificar.
  my $dec = fs($d);
  $dec =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge;
  $dec = txt($dec);                                   # bytes UTF-8 -> texto
  # Si el texto es solo el nombre del archivo ("image.png", como lo exporta
  # Notion), no se usa: pandoc lo pondría de epígrafe ("Figura 1: image.png").
  my $alt_nuevo = (NFC(lc $alt) eq NFC(lc basename($dec))
                   || $alt =~ /^\s*(?:untitled|image|imagen|pasted image[^\]]*)(?:\.\w{3,4})?\s*$/i) ? "" : $alt;
  my $resto = defined $titulo ? $titulo : "";
  if (-f fs("$carpeta/$d") || -f fs("$carpeta/$dec")) {
    return $alt_nuevo eq $alt ? $original : "![$alt_nuevo]($dest$resto)";
  }
  my $ruta = buscar($dec);
  return $original unless defined $ruta;
  return "![$alt_nuevo](<$ruta>$resto)";
}

# Nombre en castellano de cada tipo de aviso ([!NOTE], [!tip]...).
my %TIPOS = (note => "Nota", info => "Información", tip => "Consejo", hint => "Consejo",
  important => "Importante", warning => "Advertencia", caution => "Precaución",
  attention => "Atención", danger => "Peligro", error => "Error", bug => "Error",
  example => "Ejemplo", quote => "Cita", cite => "Cita", question => "Pregunta",
  faq => "Pregunta", help => "Pregunta", success => "Hecho", check => "Hecho",
  done => "Hecho", failure => "Falla", fail => "Falla", missing => "Falta",
  todo => "Pendiente", abstract => "Resumen", summary => "Resumen", tldr => "Resumen");
# Un bloque de código se cierra con la misma marca con que se abrió (``` o
# ~~~, de al menos el mismo largo): un ~~~ dentro de un ``` no lo cierra.
my $cerca = "";
sub cierra { $_[0] =~ /^\s*(`+|~+)\s*$/ && substr($1, 0, 1) eq substr($_[1], 0, 1) && length($1) >= length($_[1]) }
# Lista pegada al texto de arriba: pandoc NO la reconoce si no hay una línea
# en blanco antes, y sale como parte del párrafo. Se agrega esa línea antes
# del primer ítem (no entre los ítems de una lista que ya empezó). Es la
# misma regla que usa mdnorm: viñeta (-, *, +) o número de hasta 3 cifras
# (1. o 1)) seguido de un espacio, así un año como "1816." al principio de un
# renglón no se toma como lista.
# Hasta 3 espacios de sangría: una tabulación ya son 4 columnas (con una
# línea en blanco antes, pandoc lo leería como un bloque de código).
my $item_inicio = qr/^ {0,3}(?:[-*+]|\d{1,3}[.)])\s+\S/;
my $item = qr/^\s*(?:[-*+]|\d{1,3}[.)])\s+\S/;
my ($anterior, $en_lista, $nro, $en_yaml) = ("", 0, 0, 0);
# $en_sangrado: dentro de un bloque de código con sangría (no se toca).
# $quitar: columnas de sangría que se sacan a una lista con sangría que estaba
# pegada a un párrafo (ver más abajo).
my ($en_sangrado, $quitar) = (0, 0);
sub ancho { my $n = 0; for (split //, $_[0]) { $n = $_ eq "\t" ? $n + 4 - $n % 4 : $n + 1; } $n }
sub sangria { my ($e) = $_[0] =~ /^([ \t]*)/; ancho($e) }
sub quitar_sangria {    # saca hasta $n columnas de sangría (las tabulaciones cuentan 4)
  my ($l, $n) = @_;
  my ($e, $resto) = $l =~ /^([ \t]*)(.*)$/s;
  my $w = ancho($e);
  return (" " x ($w > $n ? $w - $n : 0)) . $resto;
}
while (my $linea = <STDIN>) {
  $nro++;
  # Cabecera YAML: sus listas ("tags:" y abajo "- uno") no se tocan.
  if ($nro == 1 && $linea =~ /^\x{FEFF}?---\s*$/) { $en_yaml = 1; print $linea; next; }
  if ($en_yaml) { $en_yaml = 0 if $linea =~ /^(?:---|\.\.\.)\s*$/; print $linea; next; }
  if ($cerca ne "") { print $linea; $cerca = "" if cierra($linea, $cerca); $anterior = $linea; next; }
  if ($linea =~ /^\s*(```+|~~~+)/) { $cerca = $1; print $linea; $anterior = $linea; next; }
  my $original = $linea;
  if ($linea !~ /\S/) {
    # Una línea en blanco sola no termina la lista (puede haber una entre
    # ítem e ítem): la termina el texto sin sangría que viene después.
  } elsif (sangria($linea) >= 4 && !$en_lista && ($en_sangrado || $anterior !~ /\S/)) {
    # Bloque de código con sangría (después de una línea en blanco, fuera de
    # una lista): es código aunque empiece con "- " o "1. ". No se toca.
    $en_sangrado = 1;
  } elsif (!$en_lista && $linea =~ $item && sangria($linea) >= 4 && $anterior =~ /\S/
           && $anterior !~ /^\s*(?:[#>|]|```|~~~)/) {
    # Ítem con sangría (4 espacios o una tabulación) pegado a un párrafo:
    # pandoc lo toma como más texto del párrafo. Con una línea en blanco y esa
    # sangría sería código, así que la lista se corre al margen (y con ella
    # los renglones que siguen, para que los ítems de abajo sigan siendo
    # hermanos o sublistas). Lo mismo que hace mdnorm.
    print $linea =~ /\r$/ ? "\r\n" : "\n";
    $quitar = sangria($linea);
    $en_lista = 1; $en_sangrado = 0;
  } elsif ($linea =~ $item_inicio) {
    print $linea =~ /\r$/ ? "\r\n" : "\n" if !$en_lista && $anterior =~ /\S/;
    $en_lista = 1; $en_sangrado = 0;
  } elsif ($linea =~ /^\S/ && $anterior !~ /\S/) {
    $en_lista = 0; $en_sangrado = 0;       # párrafo nuevo, fuera de la lista
  } elsif ($linea =~ /^#{1,6}\s/) {
    $en_lista = 0; $en_sangrado = 0;
  } elsif (sangria($linea) < 4) {
    $en_sangrado = 0;
  }
  $quitar = 0 if !$en_lista;
  $linea = quitar_sangria($linea, $quitar) if $quitar && $linea =~ /\S/;
  $anterior = $original;
  # Avisos de GitHub y callouts de Obsidian: "> [!NOTE] Título". Pandoc los
  # muestra como una cita con "[!NOTE]" a la vista: queda el título en negrita
  # (o el tipo, traducido, si no tiene título). El +/- de plegado se ignora.
  $linea =~ s{^(\s*(?:>\s*)+)\[!(\w+)\][-+]?[ \t]*(.*?)[ \t\r]*$}{
    my ($pre, $tipo, $titulo) = ($1, lc $2, $3);
    $titulo = $TIPOS{$tipo} // ucfirst($tipo) if $titulo eq "";
    (my $vacia = $pre) =~ s/\s+$//;               # línea de cita vacía: el título va solo
    "$pre**$titulo**\n$vacia"
  }e;
  # Normalización de letras matemáticas Unicode (𝐴 𝑓 𝛼 -> A f α) fuera de `código`
  $linea =~ s{(`+)(.*?)\1|([\x{1D400}-\x{1D7FF}])}{
    defined $1 ? "$1$2$1" : NFKC($3)
  }ge;
  # `código` se deja igual; ![[...]] y [[...]] se traducen
  $linea =~ s{(`+)(.*?)\1|(!?)\[\[([^\[\]\n]+?)\]\]|!\[([^\[\]\n]*)\]\((<[^>\n]+>|[^)\s]+)(\s+"[^"\n]*")?\)}{
    defined $1 ? "$1$2$1"
    : defined $4 ? traducir($3 eq "!", $4)
    : imagen_estandar($&, $5, $6, $7)
  }ge;
  print $linea;
}
PERL

# --- 5. Ejecutar pandoc y mostrar mensajes por archivo ------------------------
# Si uno falla, se sigue con los demás. "--" va antes del archivo por si algún
# nombre empieza con "-" (si no, pandoc lo tomaría por una opción).
#
# --resource-path: carpetas donde pandoc busca las imágenes (separadas por ":").
# Por defecto busca solo en la carpeta desde donde se ejecuta el comando, así
# que "md2pdf ~/notas/apunte.md" desde otra carpeta perdía las imágenes de
# ~/notas. ${archivo:h} es la carpeta del .md; después, las carpetas de -i, y
# por último la actual.
#
# Si el .md tiene algo que traducir, pandoc lee una copia traducida (en una
# carpeta temporal); las imágenes normales se siguen buscando en la carpeta
# del .md gracias a --resource-path.
fallidos=()
temporal=""
# Borrar la copia temporal al salir, también si se cancela con Ctrl+C.
trap 'rm -f -- ${temporal:+"$temporal"}' EXIT
trap 'echo; echo "Cancelado."; exit 130' INT TERM HUP
for archivo in "${archivos[@]}"; do
  salida="${archivo:r}.pdf"
  entrada="$archivo"
  temporal=""
  # Un .md que no está en UTF-8 (por ejemplo, en Latin-1, de un editor viejo
  # de Windows) no se traduce: perl lo leería mal. Pandoc lo convierte igual
  # (lo lee como Latin-1), y se avisa cómo pasarlo a UTF-8.
  if ! iconv -f UTF-8 -t UTF-8 -- "$archivo" >/dev/null 2>&1; then
    echo "⚠️ '$archivo' no está en UTF-8: se convierte sin traducir la sintaxis de Obsidian."
    echo "   Para pasarlo a UTF-8: iconv -f latin1 -t utf-8 -- \"$archivo\" > nuevo.md"
    rutas=("${archivo:h}" "${carpetas_imagenes[@]}" ".")
    if pandoc -d estilo --resource-path="${(j.:.)rutas}" --output="$salida" -- "$archivo" 2>/dev/null; then
      echo "✔ Generado: $salida"
    else
      echo "❌ Error al convertir: $archivo"
      fallidos+=("$archivo")
    fi
    continue
  fi
  # Se traduce siempre en una copia temporal, pero pandoc la lee solo si
  # cambió algo; si no, lee el .md original (como antes).
  temporal="$(mktemp --suffix=.md)"
  if ! CARPETA_MD="${archivo:h:A}" BASE="$(carpeta_de_busqueda "${archivo:h}")" \
       IMAGENES="${(F)carpetas_imagenes}" perl -CSD -e "$TRADUCIR" < "$archivo" > "$temporal"; then
    echo "❌ Error al traducir la sintaxis que pandoc no entiende: $archivo"
    fallidos+=("$archivo"); rm -f "$temporal"; temporal=""; continue
  fi
  if cmp -s -- "$archivo" "$temporal"; then
    rm -f -- "$temporal"; temporal=""
  else
    entrada="$temporal"
  fi
  rutas=("${archivo:h}" "${carpetas_imagenes[@]}" ".")
  if pandoc -d estilo --resource-path="${(j.:.)rutas}" --output="$salida" -- "$entrada"; then
    echo "✔ Generado: $salida"
  else
    echo "❌ Error al convertir: $archivo"
    fallidos+=("$archivo")
  fi
  [[ -n $temporal ]] && rm -f "$temporal"
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ No se pudieron convertir ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
  exit 1
fi
echo "✅ Conversión completa."
# Algún archivo pedido se saltó (no existía o no era un .md): código 1.
(( saltados > 0 )) && exit 1
exit 0
