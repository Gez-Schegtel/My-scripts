#!/usr/bin/env zsh

# ==============================================================================
# SCRIPT: md2pdf
# DESCRIPCIÓN:
#   Convierte archivos Markdown (.md) a formato PDF utilizando Pandoc.
#   Es un script interactivo: si se le pasan archivos por argumento, convierte
#   solo esos. Si se ejecuta sin argumentos, detecta y procesa todos los
#   archivos .md del directorio actual. Siempre pide confirmación antes de
#   iniciar la conversión.
#
#   Motor PDF: usa lualatex si está instalado; si no, xelatex; y si no, el de
#   Pandoc por defecto. El motor por defecto (pdflatex) no genera NADA si el
#   documento tiene letras griegas (α), símbolos como ✓ o emojis. xelatex los
#   acepta, pero no puede usar una fuente de respaldo para los emojis;
#   lualatex sí, y los emojis salen a color. Con lualatex el script agrega solo
#   la fuente de respaldo (Noto Color Emoji y DejaVu Sans) sobre Latin Modern
#   Roman; la nota no necesita nada especial en su cabecera YAML.
#
#   Si un archivo falla, sigue con los demás y al final informa cuáles no se
#   pudieron convertir.
#
# USO:
#   md2pdf                    (Detecta y convierte todos los .md de la carpeta)
#   md2pdf archivo.md         (Convierte solo un archivo específico)
#   md2pdf apunte1.md apunte2.md
#
# CÓDIGO DE SALIDA:
#   0 si todo se convirtió (o si cancelaste), 1 si algún archivo falló.
#
# DEPENDENCIAS REQUERIDAS:
#   - zsh (El script está escrito específicamente para Z shell)
#   - pandoc (El conversor universal de documentos)
#   - LaTeX para exportar a PDF. Con solo texlive-latex-base fallan los
#     documentos con tablas o bloques de código: hace falta
#     texlive-latex-recommended. texlive-luatex agrega el motor lualatex
#     (texlive-xetex agrega xelatex, que se usa si falta lualatex), y
#     lmodern es la fuente que Pandoc usa por defecto (sin ella, no genera
#     ningún PDF).
#   - fonts-noto-color-emoji (emojis a color en el PDF)
#
# Instalación de dependencias en Debian/Ubuntu:
#   sudo apt install zsh pandoc texlive-latex-recommended texlive-fonts-recommended texlive-luatex texlive-xetex lmodern fonts-noto-color-emoji
# ==============================================================================

setopt extended_glob

if (( ! $+commands[pandoc] )); then
  echo "❌ Error: pandoc no está instalado. Instalalo con:"
  echo "   sudo apt install pandoc texlive-latex-recommended texlive-fonts-recommended texlive-luatex texlive-xetex lmodern fonts-noto-color-emoji"
  exit 1
fi

# Motor PDF: lualatex si está disponible; si no, xelatex; si no, el de Pandoc
motor=()
if (( $+commands[lualatex] )); then
  # Con lualatex se agrega solo la fuente de respaldo para emojis y símbolos,
  # así las notas no necesitan copiar nada en su cabecera YAML. Usa Latin
  # Modern Roman como fuente principal (pisa el "mainfont" de la nota).
  cabecera=$(mktemp) || exit 1
  trap 'rm -f "$cabecera"' EXIT
  cat > "$cabecera" <<'FUENTES'
\directlua{
  luaotfload.add_fallback("emojis", {"Noto Color Emoji:mode=harf;", "DejaVu Sans:"})
}
\setmainfont{Latin Modern Roman}[RawFeature={fallback=emojis}]
FUENTES
  motor=(--pdf-engine=lualatex --include-in-header="$cabecera")
elif (( $+commands[xelatex] )); then
  motor=(--pdf-engine=xelatex)
fi

# 1. Construimos la lista de archivos a convertir
archivos=()

if (( $# > 0 )); then
  # Si pasaste archivos por argumento: md2pdf a.md b.md
  for archivo in "$@"; do
    if [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
    elif [[ "${(L)archivo:e}" != (md|markdown) ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo Markdown (.md)."
    else
      archivos+=("$archivo")
    fi
  done
else
  # Si no pasaste nada: todos los .md del directorio (también .MD o .markdown)
  archivos=( *.(#i)(md|markdown)(N.) )
fi

# 2. Si no hay archivos, salimos
if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos Markdown para convertir."
  exit 0
fi

# 3. Mostrar qué se va a convertir (el PDF reemplaza la extensión .md)
echo "Se van a convertir los siguientes archivos:"
for archivo in "${archivos[@]}"; do
  echo "  - $archivo -> ${archivo:r}.pdf"
done

# 4. Pedir confirmación
read "respuesta?¿Continuar? [s/N]: "
case "$respuesta" in
  s|S|y|Y)
    echo "Iniciando conversión..."
    ;;
  *)
    echo "Operación cancelada."
    exit 0
    ;;
esac

# 5. Ejecutar pandoc y mostrar mensajes por archivo. Si uno falla, se sigue
#    con los demás ("--" por si algún nombre empieza con "-").
fallidos=()
for archivo in "${archivos[@]}"; do
  salida="${archivo:r}.pdf"
  if pandoc "${motor[@]}" --output="$salida" -- "$archivo"; then
    echo "✔ Generado: $salida"
  else
    echo "❌ Error al convertir: $archivo"
    fallidos+=("$archivo")
  fi
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ No se pudieron convertir ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
  exit 1
fi
echo "✅ Conversión completa."
