#!/usr/bin/env zsh
# SPDX-License-Identifier: GPL-3.0-or-later

# ==============================================================================
# SCRIPT: mdnorm
# DESCRIPCIÓN:
#   Normaliza archivos Markdown para que pandoc los convierta bien a PDF. Hace
#   solo cambios mínimos y deja todo lo demás tal cual: no reformatea párrafos,
#   títulos, fórmulas ni código.
#
#   Muchas notas (sobre todo las de Obsidian) se ven bien en el editor pero
#   pandoc las lee distinto, porque el Markdown de pandoc es más estricto. Lo
#   que arregla:
#
#   1. Líneas en blanco que faltan. Pandoc NO reconoce una lista, una tabla o
#      una cita (">") pegada al párrafo de arriba: la toma como texto común.
#      Agrega una línea en blanco antes de:
#        - una lista con viñetas (-, *, +) o numerada que empieza en 1;
#        - una tabla;
#        - una cita.
#      Entre los ítems de una lista que ya empezó no agrega nada (la lista no
#      se parte).
#
#   2. Títulos. Pandoc tampoco reconoce un título (# Título) pegado al
#      párrafo de arriba: sale como texto con el "#". Agrega la línea en
#      blanco antes. Las etiquetas de Obsidian (#etiqueta, sin espacio) no son
#      títulos y no se tocan.
#
#   3. Tablas. Pandoc borra SIN AVISAR las columnas de más: si una fila tiene
#      más celdas que el encabezado, o si la línea separadora (|---|---|) tiene
#      menos columnas que el encabezado. Y si una celda tiene <br>, lo borra y
#      pega las palabras ("1<br>2" sale "12"). En esos casos:
#        - agrega columnas al encabezado y al separador para que entren todas
#          las celdas (las de más quedan con encabezado vacío);
#        - cambia los <br> de las celdas por un espacio.
#      Solo se reescriben las líneas que tienen alguno de esos problemas; las
#      demás quedan exactamente como estaban (alineación, espacios y anchos
#      del separador incluidos).
#
#   4. Imágenes de Obsidian a Markdown estándar:
#        ![[foto.png]]             ->  ![](assets/foto.png)
#        ![[foto.png|300]]         ->  ![](assets/foto.png){width=300px}
#        ![[foto.png|derecha]]     ->  ![](assets/foto.png){.derecha}
#      ("izquierda" también vale, y se combina con el ancho: |derecha|300.)
#      La imagen se busca como en md2pdf: en la carpeta del .md, y si no, por
#      nombre en todo el vault (la carpeta con .obsidian/), o en el
#      repositorio git, o en la carpeta del .md y sus subcarpetas. La ruta
#      queda relativa a la nota, con %20 en lugar de los espacios (como la
#      escribe Obsidian). OJO: Obsidian no entiende {width=...} y lo muestra
#      como texto al lado de la imagen; en el PDF sale bien.
#      Si no encuentra la imagen, o si tiene otro texto después del | (por
#      ejemplo un texto alternativo), la deja como está y avisa.
#      Los enlaces a notas ([[Nota]]) no se tocan.
#
#   5. Cabecera YAML (entre --- al principio del archivo). Arregla los
#      errores que hacen fallar a pandoc o que cambian el valor sin avisar,
#      en las claves de primer nivel ("clave: valor"):
#        title: Unidad III: Subsistema  ->  title: 'Unidad III: Subsistema'
#      Pone el valor entre comillas simples cuando hace falta: si tiene ": "
#      o termina en ":"; si tiene " #" (pandoc tomaría el resto como un
#      comentario y lo borraría: "Unidad #3" quedaba "Unidad"); o si empieza
#      con un carácter especial (@ ` [ { * & ! % ? , | > o "- "). No toca
#      valores como true, 11pt o \today, ni las listas [a, b].
#        title:Hola       ->  title: Hola       (faltaba el espacio)
#        title: "Hola     ->  title: "Hola"     (faltaba cerrar la comilla)
#      Si falta el --- de cierre, lo agrega en la primera línea en blanco
#      (sin él, toda la cabecera salía como texto en el PDF). Si una clave
#      está repetida, avisa (pandoc usa la última sin decir nada).
#      Las listas y los valores anidados no se tocan. Al final, si pandoc
#      está instalado, se comprueba que la cabecera se pueda leer y, si no,
#      se muestra el error de pandoc.
#
#   No toca: los bloques de código (``` o ~~~), el código en línea (`...`),
#   las fórmulas $$...$$ ni los entornos de LaTeX (\begin...\end).
#
#   Cómo funciona: arma la versión normalizada, muestra las diferencias y
#   pregunta antes de guardar (y o ENTER aceptan). Si no hay nada que cambiar,
#   lo dice y no toca el archivo. Pasar el script dos veces da lo mismo que
#   pasarlo una.
#
# USO:
#   mdnorm nota.md            (Normaliza un archivo, mostrando los cambios)
#   mdnorm a.md b.md          (Varios archivos; pregunta por cada uno)
#   mdnorm                    (Todos los .md de la carpeta actual)
#   mdnorm -n nota.md         (-n o --mostrar: solo muestra los cambios, no
#                              guarda nada)
#   mdnorm -y nota.md         (-y o --yes: guarda sin preguntar)
#
# CÓDIGO DE SALIDA:
#   0 si terminó bien, 1 si falló algún archivo o falta una dependencia.
#
# DEPENDENCIAS REQUERIDAS:
#   - zsh y perl (vienen en Debian/Ubuntu; zsh: sudo apt install zsh)
#   - diff (paquete diffutils, viene instalado) para mostrar los cambios.
#   - git es opcional: si está, se usa para encontrar la raíz del repositorio
#     y para mostrar los cambios con colores.
# ==============================================================================

# extended_glob: permite el patrón *.(#i)(md|markdown)(N.) de más abajo.
setopt extended_glob

# --- Comprobaciones previas ---------------------------------------------------
for programa in perl diff; do
  if (( ! $+commands[$programa] )); then
    echo "❌ Error: falta '$programa'."
    exit 1
  fi
done

# --- Opciones -----------------------------------------------------------------
# zparseopts saca las opciones de los argumentos (-E: en cualquier posición);
# -F falla con una opción que no existe. Un "--" suelto se descarta.
uso="Uso: mdnorm [-y | -n] [archivo.md ...]"
zparseopts -D -E -F -- y=opcion_y -yes=opcion_y n=opcion_n -mostrar=opcion_n 2>/dev/null || {
  echo "❌ Opción no válida. $uso"
  exit 1
}
[[ $1 == -- ]] && shift
if (( $#opcion_y && $#opcion_n )); then
  echo "❌ -y y -n no van juntas. $uso"
  exit 1
fi

# --- 1. Lista de archivos -----------------------------------------------------
archivos=()
if (( $# > 0 )); then
  for archivo in "$@"; do
    if [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
    elif [[ "${(L)archivo:e}" != (md|markdown) ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo Markdown (.md)."
    else
      archivos+=("$archivo")
    fi
  done
else
  archivos=( *.(#i)(md|markdown)(N.) )
fi
if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos Markdown para normalizar."
  exit 0
fi

# --- Dónde buscar las imágenes por nombre --------------------------------------
# El vault de Obsidian (la carpeta que contiene .obsidian/), si no el
# repositorio git, si no la carpeta del .md. (Igual que en md2pdf.)
carpeta_de_busqueda() {
  local carpeta=${1:A} d=${1:A} raiz
  while [[ $d != / ]]; do
    [[ -d $d/.obsidian ]] && { print -r -- $d; return }
    d=${d:h}
  done
  if raiz=$(git -C "$carpeta" rev-parse --show-toplevel 2>/dev/null); then
    print -r -- $raiz
  else
    print -r -- $carpeta
  fi
}

# --- El normalizador (perl) ---------------------------------------------------
# Lee el .md por la entrada estándar y escribe la versión normalizada. Recibe
# CARPETA_MD (carpeta del .md) y BASE (dónde buscar imágenes por nombre). Los
# avisos salen por la salida de errores.
read -r -d '' NORMALIZAR <<'PERL'
use strict; use warnings; use utf8;
use File::Find; use File::Basename qw(basename); use File::Spec;
use Encode qw(encode decode);
sub fs  { encode("UTF-8", $_[0]) }
sub txt { decode("UTF-8", $_[0]) }
my $carpeta = txt($ENV{CARPETA_MD});
my $base    = txt($ENV{BASE});
my %indice; my $indexado = 0;

# --- Imágenes ---
sub buscar {
  my ($ruta) = @_;
  return "$carpeta/$ruta" if -f fs("$carpeta/$ruta");
  return "$base/$ruta"    if -f fs("$base/$ruta");
  if (!$indexado) {
    my $raiz = fs($base);
    find({ no_chdir => 1, wanted => sub {
      if (-d $_ && basename($_) =~ /^\./ && $_ ne $raiz) { $File::Find::prune = 1; return; }
      if (-f $_) { my $r = txt($_); push @{ $indice{basename($r)} }, $r; }
    } }, $raiz);
    $indexado = 1;
  }
  my @c = @{ $indice{basename($ruta)} || [] };
  my $fin = "/$ruta";
  my @exactos = grep { substr($_, -length($fin)) eq $fin } @c;
  @c = @exactos if @exactos;
  return undef unless @c;
  return (sort { length($a) <=> length($b) || $a cmp $b } @c)[0];
}

sub ruta_md {   # ruta relativa a la nota, apta para Markdown
  my ($abs) = @_;
  my $rel = File::Spec->abs2rel($abs, $carpeta);
  $rel =~ s/([ ()<>#%])/sprintf("%%%02X", ord($1))/ge;
  return $rel;
}

sub imagen_obsidian {
  my ($original, $dentro) = @_;
  my ($destino, @extra) = split /\|/, $dentro;
  $destino =~ s/\\$//; $destino =~ s/^\s+|\s+$//g;
  return $original if $destino =~ /#/;                      # sección de una nota
  return $original unless $destino =~ /\.(png|jpe?g|gif|bmp|webp|svg|pdf)$/i;
  my (@attr, $raro);
  for my $t (@extra) {
    $t =~ s/\\$//; $t =~ s/^\s+|\s+$//g;
    if    ($t =~ /^(\d+)(?:x\d+)?$/)           { push @attr, "width=$1px" unless grep { /^width=/ } @attr; }
    elsif ($t =~ /^(izquierda|derecha)$/i)    { push @attr, "." . lc($1) unless grep { /^\./ } @attr; }
    elsif ($t ne "")                          { $raro = $t; }
  }
  if (defined $raro) {
    warn "   ⚠️  La dejé como está (tiene el texto \"$raro\" después del |): $original\n";
    return $original;
  }
  my $ruta = buscar($destino);
  if (!defined $ruta) {
    warn "   ⚠️  No encontré la imagen, la dejé como está: $original\n";
    return $original;
  }
  my $atributos = @attr ? "{" . join(" ", @attr) . "}" : "";
  return "![](" . ruta_md($ruta) . ")$atributos";
}

sub imagenes_en_linea {
  my ($l) = @_;
  $l =~ s{(`+)(.*?)\1|!\[\[([^\[\]\n]+?)\]\]}{ defined $1 ? "$1$2$1" : imagen_obsidian($&, $3) }ge;
  return $l;
}

# --- Tablas ---
sub celdas {    # divide una fila por los | que separan celdas
  # No cuentan los | escapados (\|) ni los que están dentro de `código` o de
  # una fórmula ($|x|$), igual que hace pandoc.
  my ($fila) = @_;
  my $s = $fila; $s =~ s/^\s+|\s+$//g;
  my @c; my $act = "";
  while (length $s) {
    if ($s =~ s/^(\\.)//)            { $act .= $1; }
    elsif ($s =~ s/^((`+).*?(?<!`)\2(?!`))//) { $act .= $1; }   # código en línea
    elsif ($s =~ s/^(\$\$.+?\$\$)//)  { $act .= $1; }             # fórmula $$...$$
    elsif ($s =~ s/^(\$(?=\S)[^\$]*?(?<=\S)\$(?!\d))//) { $act .= $1; }   # fórmula $...$
    elsif ($s =~ s/^\|//)             { push @c, $act; $act = ""; }
    else { $s =~ s/^(.)//s; $act .= $1; }
  }
  push @c, $act;
  shift @c if @c && $c[0] =~ /^\s*$/ && $fila =~ /^\s*\|/;   # | del principio
  pop @c   if @c && $c[-1] =~ /^\s*$/ && $fila =~ /\|\s*$/;  # | del final
  s/^\s+|\s+$//g for @c;
  return @c;
}
sub es_separador {
  my ($l) = @_;
  return $l =~ /\|/ && $l =~ /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/;
}

sub arreglar_tabla {    # recibe las líneas de una tabla, devuelve las nuevas
  # Solo cambia lo que hace falta: las líneas que ya están bien quedan tal
  # cual (con su alineación y sus espacios).
  my ($sangria, @lineas) = @_;
  my @c = map { [ celdas($_) ] } @lineas;
  my $n = 0;
  for (@c) { $n = @$_ if @$_ > $n; }
  my $fila = sub { $sangria . "| " . join(" | ", @{$_[0]}) . " |" };
  my @res;
  for my $k (0..$#lineas) {
    my @f = @{ $c[$k] };
    my $cambia = 0;
    if ($k == 1) {                              # separador
      if (@f < $n) { push @f, "---" while @f < $n; $cambia = 1; }
    } else {
      if (grep { /<br\s*\/?>/i } @f) { s/<br\s*\/?>/ /gi for @f; $cambia = 1; }
      # El encabezado necesita tantas columnas como la fila más larga; las
      # filas cortas pandoc las completa solo.
      if ($k == 0 && @f < $n) { push @f, "" while @f < $n; $cambia = 1; }
    }
    push @res, $cambia ? $fila->(\@f) : $lineas[$k];
  }
  return @res;
}

# --- Recorrido línea por línea ---
my @in = <STDIN>;
chomp @in;

# --- Cabecera YAML ---
# Solo se tocan las claves de primer nivel ("clave: valor" sin sangría). Las
# listas, los valores anidados y los bloques (| o >) quedan como están.
sub aviso { warn "   ⚠️  $_[0]\n"; }

sub arreglar_valor {    # devuelve el valor arreglado, o undef si está bien
  my ($v) = @_;
  my $t = $v; $t =~ s/\s+$//;
  return undef if $t eq "";
  return undef if $t =~ /^[|>][-+0-9]*$/;                 # bloque | o >
  if ($t =~ /^"/) {                                       # entre comillas dobles
    my $sin = $t; $sin =~ s/\\.//g;
    my $n = () = $sin =~ /"/g;
    return $n % 2 ? qq{$t"} : undef;                      # cierra la que falta
  }
  if ($t =~ /^'/) {                                       # entre comillas simples
    my $sin = $t; $sin =~ s/''//g;
    my $n = () = $sin =~ /'/g;
    return $n % 2 ? qq{$t'} : undef;
  }
  return undef if $t =~ /^\[.*\]$/ || $t =~ /^\{.*\}$/;  # lista [a, b] o {...}
  my $hace_falta =
       $t =~ /:\s/ || $t =~ /:$/         # dos puntos seguidos de espacio, o al final
    || $t =~ /\s#/                       # " #": el resto sería un comentario
    || $t =~ /^[\@`\[\{*&!%?,|>]/        # empieza con un carácter especial
    || $t =~ /^-\s/;                     # "- algo" (parece una lista)
  return undef unless $hace_falta;
  (my $e = $t) =~ s/'/''/g;
  return "'$e'";
}

if (@in && $in[0] =~ /^---\s*$/) {
  my $cierre;
  for my $k (1..$#in) { if ($in[$k] =~ /^(---|\.\.\.)\s*$/) { $cierre = $k; last; } }
  if (!defined $cierre) {
    # Falta el --- de cierre: la cabecera termina en la primera línea en
    # blanco (o en la primera que no parece YAML).
    my $k = 1;
    while ($k < @in && $in[$k] =~ /\S/ &&
           ($in[$k] =~ /^\s/ || $in[$k] =~ /^-\s/ || $in[$k] =~ /^[\w-]+\s*:/ || $in[$k] =~ /^#/)) { $k++; }
    if ($k > 1) {
      splice @in, $k, 0, ($in[0] =~ /\r$/ ? "---\r" : "---");
      $cierre = $k;
      aviso("Faltaba el --- que cierra la cabecera: lo agregué después de la línea $k.");
    }
  }
  if (defined $cierre) {
    my (%visto);
    for my $k (1..$cierre-1) {
      my $l = $in[$k];
      my $cr = $l =~ s/\r$// ? "\r" : "";
      if ($l =~ /^\s/ || $l !~ /\S/) { $in[$k] = $l . $cr; next; }   # anidado o vacío
      if ($l =~ /^([\w-]+):(\S.*)$/ && $l !~ /^[\w-]+:\/\//) {
        aviso("Línea " . ($k+1) . ": faltaba el espacio después de \"$1:\".");
        $l = "$1: $2";
      }
      if ($l =~ /^([\w-]+):(\s*)(.*)$/) {
        my ($clave, $esp, $valor) = ($1, $2, $3);
        push @{ $visto{$clave} }, $k+1;
        my $nuevo = arreglar_valor($valor);
        if (defined $nuevo) {
          aviso("Línea " . ($k+1) . ": " . ($valor =~ /^["']/ ? "cerré la comilla de" : "puse entre comillas") . " \"$clave\" ($nuevo).");
          $l = "$clave: $nuevo";
        }
      }
      $in[$k] = $l . $cr;
    }
    for my $clave (sort keys %visto) {
      my @ls = @{ $visto{$clave} };
      aviso("\"$clave\" está repetida (líneas " . join(", ", @ls) . "): pandoc usa la última. Borrá la que sobre.") if @ls > 1;
    }
  }
}

my @out;
my ($en_yaml, $en_codigo, $cerca, $en_math, $en_latex) = (0, 0, "", 0, 0);
my $en_lista = 0;     # dentro de una lista que ya empezó
my $en_cita  = 0;
my $item  = qr/^\s*(?:[-*+]|\d+[.)])\s+\S/;
my $item_inicio = qr/^\s{0,3}(?:[-*+]|1[.)])\s+\S/;
my $cita  = qr/^\s{0,3}>/;

# Si el archivo usa saltos de línea de Windows (\r\n), la línea agregada también.
my $vacia = (@in && $in[0] =~ /\r$/) ? "\r" : "";
sub blanco_antes { push @out, $vacia if @out && $out[-1] =~ /\S/; }

for (my $i = 0; $i < @in; $i++) {
  my $l = $in[$i];

  # Cabecera YAML: solo si es la primera línea
  if ($i == 0 && $l =~ /^---\s*$/) { $en_yaml = 1; push @out, $l; next; }
  if ($en_yaml) { push @out, $l; $en_yaml = 0 if $l =~ /^(---|\.\.\.)\s*$/; next; }

  # Bloques de código
  if ($en_codigo) { push @out, $l; $en_codigo = 0 if $l =~ /^\s*\Q$cerca\E/; next; }
  if ($l =~ /^\s*(```+|~~~+)/) { $cerca = $1; $en_codigo = 1; push @out, $l; next; }

  # Fórmulas $$ ... $$ y entornos de LaTeX
  if ($en_math) { push @out, $l; my $k = () = $l =~ /\$\$/g; $en_math = 0 if $k % 2; next; }
  if ($l =~ /^\s*\$\$/) { my $k = () = $l =~ /\$\$/g; $en_math = 1 if $k % 2; push @out, $l; next; }
  if ($en_latex) { push @out, $l; $en_latex += () = $l =~ /\\begin\{/g; $en_latex -= () = $l =~ /\\end\{/g; next; }
  if ($l =~ /^\s*\\begin\{/) {
    $en_latex = (() = $l =~ /\\begin\{/g) - (() = $l =~ /\\end\{/g);
    $en_latex = 0 if $en_latex < 0;
    push @out, $l; next;
  }

  # Tabla: una fila con | seguida de una línea separadora
  if ($l =~ /\|/ && $i + 1 < @in && es_separador($in[$i+1]) && !es_separador($l)) {
    my ($sangria) = $l =~ /^(\s*)/;
    my @t = ($l, $in[$i+1]);
    my $j = $i + 2;
    while ($j < @in && $in[$j] =~ /\S/ && $in[$j] =~ /\|/) { push @t, $in[$j]; $j++; }
    blanco_antes();
    push @out, map { imagenes_en_linea($_) } arreglar_tabla($sangria, @t);
    $i = $j - 1; $en_lista = 0; $en_cita = 0;
    next;
  }

  if ($l !~ /\S/) {                       # línea en blanco
    push @out, $l; $en_cita = 0;
    next;
  }

  if ($l =~ /^#{1,6}\s+\S/) {           # título: siempre con una línea en blanco antes
    blanco_antes();
    $en_lista = 0; $en_cita = 0;
  } elsif ($l =~ $item) {
    if (!$en_lista && $l =~ $item_inicio) { blanco_antes(); }
    $en_lista = 1 if $en_lista || $l =~ $item_inicio || ($out[-1] // "") !~ /\S/;
    $en_cita = 0;
  } elsif ($l =~ $cita) {
    blanco_antes() unless $en_cita;
    $en_cita = 1;
  } elsif ($l !~ /^\s/ && ($out[-1] // "") !~ /\S/) {
    $en_lista = 0;                        # párrafo nuevo, fuera de la lista
  }

  push @out, imagenes_en_linea($l);
}
print "$_\n" for @out;
PERL

# --- 2. Procesar cada archivo -------------------------------------------------
# Si git está, muestra las diferencias con colores; si no, con diff común.
mostrar_cambios() {
  if (( $+commands[git] )); then
    git --no-pager diff --no-index --color=auto -- "$1" "$2" | tail -n +5
  else
    diff -u -- "$1" "$2" | tail -n +3
  fi
}

fallidos=()
for archivo in "${archivos[@]}"; do
  temporal="$(mktemp --suffix=.md)"
  echo "── $archivo"
  if ! CARPETA_MD="${archivo:h:A}" BASE="$(carpeta_de_busqueda "${archivo:h}")" \
       perl -CSD -e "$NORMALIZAR" < "$archivo" > "$temporal"; then
    echo "   ❌ Error al normalizar."
    fallidos+=("$archivo"); rm -f "$temporal"; continue
  fi
  # Si el original no terminaba con salto de línea, se respeta.
  if [[ -s $archivo && "$(tail -c 1 -- "$archivo")" != "" ]]; then
    printf '%s' "$(<"$temporal")" > "$temporal"
  fi
  # Si pandoc está, se comprueba que la cabecera YAML se pueda leer.
  error_yaml=""
  if (( $+commands[pandoc] )) && [[ "$(head -n 1 -- "$temporal")" == ---* ]]; then
    error_yaml=$(pandoc -f markdown -t plain -o /dev/null -- "$temporal" 2>&1 | grep -i -A3 'yaml')
    if [[ -n $error_yaml ]]; then
      echo "   ❌ La cabecera YAML sigue con un error que no pude arreglar solo"
      echo "      (pandoc cuenta las líneas desde la que sigue al primer ---):"
      print -r -- "$error_yaml" | sed 's/^/      /'
    fi
  fi
  if cmp -s -- "$archivo" "$temporal"; then
    if [[ -n $error_yaml ]]; then
      echo "   No hay nada más para cambiar."
    else
      echo "   ✔ Ya estaba bien, sin cambios."
    fi
    rm -f "$temporal"; continue
  fi
  mostrar_cambios "$archivo" "$temporal"
  if (( $#opcion_n )); then
    echo "   (Solo se muestran los cambios: no se guardó nada.)"
    rm -f "$temporal"; continue
  fi
  if (( ! $#opcion_y )); then
    read "respuesta?¿Guardar los cambios en $archivo? [Y/n]: " || respuesta=n
    if [[ $respuesta != (y|Y|) ]]; then
      echo "   Sin cambios."
      rm -f "$temporal"; continue
    fi
  fi
  # cat > archivo mantiene los permisos y el archivo original (no lo reemplaza).
  if cat -- "$temporal" > "$archivo"; then
    echo "   ✔ Guardado."
  else
    echo "   ❌ No se pudo guardar."
    fallidos+=("$archivo")
  fi
  rm -f "$temporal"
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ Fallaron ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
  exit 1
fi
