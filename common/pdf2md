# ==============================================================================
# SCRIPT: pdf2md
# DESCRIPCIÓN:
#   Convierte archivos PDF (.pdf) a Markdown (.md), haciendo el camino inverso
#   de md2pdf. Está pensado principalmente para recuperar el Markdown original
#   de los PDF generados con mi configuración de estilo ("pandoc -d estilo"),
#   incluyendo la cabecera YAML (title, subtitle, author, date, toc, márgenes,
#   tipografías, interlineado...), títulos, listas (con su anidamiento y las
#   tareas - [ ] / - [x]), tablas (simples y de varias páginas, incluidas
#   las de grilla completa de Google Docs, Word, LibreOffice o un navegador,
#   con celdas combinadas y viñetas dentro de las celdas), bloques de código
#   con su lenguaje, código en línea, fórmulas en LaTeX ($...$ y $$...$$),
#   citas, enlaces, emojis de Noto Color Emoji e imágenes con sus atributos
#   ({.derecha width=25%}, etc.). También funciona con PDF de texto comunes.
#
#   Índice: si el PDF tiene índice, la cabecera lleva "toc: true" y
#   "toc-depth" (el nivel más hondo que aparece en el índice), y no se copia
#   el índice como texto. También se reconoce el índice de un documento con
#   títulos sin número ("# Título {-}"), que LaTeX marca igual que el título
#   del índice: es un índice si ese primer título se llama "Índice",
#   "Contenido" o "Contents". Si además algún título tiene número, el
#   original usaba numbersections: la cabecera lleva "numbersections: true"
#   (y "classoption: numbers=enddot" si los números terminan en punto) y cada
#   título sin número, {-}. Con títulos en letra sin serifa y texto con
#   serifa, agrega "documentclass: scrartcl". Un "####" sin número sale en el
#   PDF como "0.0.0.1. * Título" (por cómo el estilo redefine esos títulos)
#   y vuelve a ser "#### Título {-}". Un título de dos renglones queda en uno
#   aunque el título siguiente esté muy cerca.
#
#   Superíndices, subíndices y notas al pie: los superíndices y subíndices
#   del texto (250 m², H₂O, 1º) se escriben como ^2^ y ~2~, la forma de
#   pandoc. Las notas al pie (al final de la página, cada una con el número
#   de su llamada en el texto) se escriben como [^1] en el texto y
#   "[^1]: texto de la nota" al final del documento. Los números de página
#   sueltos al pie (LibreOffice, Word) se descartan y las ligaduras (ﬁ, ﬂ)
#   se pasan a letras comunes.
#
#   Saltos de línea: en los PDF que no son de LaTeX (Google Docs, Word,
#   LibreOffice, un navegador), un renglón corto solo se toma como un salto
#   de línea a propósito si la primera palabra del renglón siguiente entraba
#   en el espacio que quedó; si no entraba, es el corte normal del renglón y
#   se une al párrafo. Lo mismo con los títulos largos que ocupan varios
#   renglones, que quedan en un solo título. (En un párrafo justificado de
#   LibreOffice un salto a propósito no se distingue de un corte normal y se
#   une.) Un renglón que empieza con el número que sigue al del renglón de
#   arriba ("3.1." y "3.2.") es siempre un salto a propósito, aunque el de
#   arriba llegue casi al margen. Para saber si dos renglones son del mismo
#   párrafo se usa el interlineado real del documento cuando es mayor que el
#   de md2pdf (por ejemplo, interlineado 1,5 en Google Docs). Si los
#   títulos del documento son más
#   chicos que los de Google Docs (LibreOffice, Word), el más grande pasa a
#   ser #.
#
#   Títulos de los PDF que no son de LaTeX: además de los de letra más grande
#   o en negrita, se reconocen los subtítulos numerados en letra más chica
#   que el texto ("1. Competencias Cardinales"), los renglones cortos sueltos
#   con más espacio arriba y abajo y sin punto final ("Escala de Impacto"), y
#   los que figuran en el índice del PDF aunque la letra sea apenas más
#   grande (Google Docs lo arma con los estilos de título). Un renglón en
#   negrita que empieza con un número solo es un título si está en el margen:
#   corrido, es un ítem de una lista numerada. Los títulos centrados de la
#   carátula (primera página) se escriben como un bloque centrado de LaTeX
#   (\begin{center}), con la letra grande, porque el Markdown no puede
#   centrar un título. Un renglón suelto justo antes de una imagen (como el
#   título de un gráfico) lleva antes \needspace{...}, definido en el
#   estilo, para que no quede solo al pie de la página con la imagen en la
#   siguiente.
#
#   Ida y vuelta: con un PDF de md2pdf, el .md que genera vuelve a dar el
#   mismo PDF (idéntico) si se exporta con la misma versión del estilo con
#   que se hizo el original. Si el estilo cambió después (otra separación de
#   listas, otra letra...), el contenido es el mismo pero los saltos de página
#   pueden caer en otro lugar.
#   Un renglón de un párrafo que en el PDF empieza con "2.", "-", "#" o ">"
#   se escapa ("2\. Texto") para que siga siendo un párrafo y no se lea como
#   una lista, un título o una cita. Las tablas que siguen en otra página se
#   unen, repitan o no el encabezado; si una fila quedó partida entre las dos
#   páginas (el texto de arriba queda cortado y sigue en minúscula), se
#   vuelve a unir en una sola fila. Las celdas con un "-" lo conservan. Si
#   una celda tiene varias viñetas, la tabla se escribe como "grid table" de
#   pandoc (con bordes de +, - y |), que admite listas dentro de las celdas:
#   cada ítem va en un solo renglón (el estilo lee el Markdown con
#   hard_line_breaks) y los anchos conservan la proporción del PDF.
#
#   Cómo maneja las listas: el nivel de cada ítem sale de su posición en el
#   PDF comparada con la de los ítems de arriba, así que funciona aunque el
#   programa que hizo el PDF corra las listas del margen. Las sublistas
#   numeradas (y las viñetas debajo de un número) llevan 4 espacios, que es
#   lo que necesita pandoc para anidarlas. Dos ítems con la viñeta o el
#   número en la misma posición son hermanos aunque el texto empiece en otro
#   lugar (en Google Docs varía según el ancho del número). Los renglones de
#   un ítem que se corta siguen siendo parte del ítem mientras empiecen a la
#   derecha de la viñeta o del número; un párrafo aparte que empieza a la
#   altura del texto del ítem (después de un espacio o en la página
#   siguiente) es otro párrafo del mismo ítem y lleva su sangría. Se
#   reconocen las viñetas de LaTeX,
#   Google Docs, Word y LibreOffice (•, ●, ○, ◦, ■, ▪, ‣, ➢, ❖ y la "–" con
#   sangría del segundo nivel), las de las letras de símbolos (OpenSymbol,
#   Symbol, Wingdings) y las que los navegadores dibujan como figuras.
#
#   Cómo maneja las imágenes:
#     - Los emojis incrustados por LuaLaTeX (Noto Color Emoji) se reconocen y
#       vuelven al carácter emoji original en el texto (no se guardan como
#       archivos de imagen sueltos).
#     - Si una imagen del PDF ya existe en la carpeta del PDF (o en subcarpetas
#       comunes como assets/, img/, images/, imagenes/), se enlaza a ese archivo
#       existente (por ejemplo, ./logo_utn.png).
#     - Si la imagen no está en el disco, se extrae al lado del .md como
#       <nombre>_img_<N>.png y se enlaza desde el Markdown.
#
#   Cómo funciona:
#     1. Arma la lista de archivos: los que se pasan como argumento o, si no se
#        pasa ninguno, todos los .pdf de la carpeta actual.
#     2. Los muestra y pide confirmación (y o ENTER aceptan; cualquier otra
#        respuesta cancela). Con -y no pregunta.
#     3. Convierte cada PDF y guarda el .md al lado con el mismo nombre
#        (apunte.pdf -> apunte.md).
#     4. Si un PDF contiene tipografías no soportadas, caracteres sin texto
#        legible o no tiene capa de texto (por ejemplo si está escaneado), el
#        script avisa y no genera el archivo para evitar producir un documento
#        incorrecto. Lo mismo si el PDF tiene contraseña para abrirlo, está
#        dañado o no es un PDF (un archivo vacío o con otro contenido).
#     5. Si un archivo falla, sigue con los demás y al final informa cuáles
#        no se pudieron convertir.
#
# USO:
#   pdf2md                    (Detecta y convierte todos los .pdf de la carpeta)
#   pdf2md archivo.pdf        (Convierte solo un archivo específico)
#   pdf2md apunte1.pdf apunte2.pdf
#   pdf2md ~/notas/*.pdf      (Los archivos pueden estar en cualquier carpeta)
#   pdf2md -y archivo.pdf     (-y o --yes: convierte sin pedir confirmación;
#                              va con cualquiera de las formas de arriba)
#   pdf2md -h                 (-h o --help: muestra esta ayuda)
#
# CÓDIGO DE SALIDA:
#   0 si todo se convirtió (o si cancelaste), 1 si algún archivo falló, si
#   alguno de los que pasaste no existe o no es un PDF, o si falta alguna
#   dependencia.
#
# DEPENDENCIAS REQUERIDAS:
#   - zsh (El script está escrito específicamente para Z shell)
#   - mutool (paquete mupdf-tools, para leer la posición y fuente de cada glifo)
#   - python3 con los módulos lxml, pdfminer y PIL/Pillow
#   - fonts-noto-color-emoji (opcional pero recomendado: permite reconocer los
#     emojis incrustados como imágenes en el PDF)
#
# Instalación de dependencias en Debian/Ubuntu:
#   sudo apt install zsh mupdf-tools python3 python3-lxml python3-pdfminer python3-pil fonts-noto-color-emoji
# ==============================================================================

setopt extended_glob

uso="Uso: pdf2md [-y] [-h] [archivo.pdf ...]"

usage() {
  cat <<'EOF'
Uso: pdf2md [-y] [-h] [archivo.pdf ...]

Convierte archivos PDF (.pdf) a Markdown (.md), recuperando la estructura,
cabecera YAML, tablas (también las de Google Docs, Word o LibreOffice),
bloques de código, fórmulas, citas, superíndices (^2^), subíndices (~2~),
notas al pie ([^1]), emojis e imágenes.
Si no le pasás ningún archivo, busca todos los .pdf de la carpeta actual.
Si un archivo contiene tipografías no soportadas, caracteres sin texto legible
o carece de capa de texto (escaneado), avisa y no realiza la conversión.

Opciones:
  -y, --yes   Convierte sin pedir confirmación.
  -h, --help  Muestra esta ayuda y sale.
EOF
}

# --- Opciones -----------------------------------------------------------------
zparseopts -D -E -F -- y=opcion_y -yes=opcion_y \
    h=opcion_h -help=opcion_h 2>/dev/null || {
  echo "❌ Opción no válida. $uso"
  exit 1
}
[[ $1 == -- ]] && shift

if (( $#opcion_h )); then
  usage
  exit 0
fi

# --- Comprobaciones previas ---------------------------------------------------
if (( ! $+commands[mutool] )); then
  echo "❌ Error: mutool no está instalado. Instalalo con:"
  echo "   sudo apt install mupdf-tools"
  exit 1
fi

if (( ! $+commands[python3] )); then
  echo "❌ Error: python3 no está instalado. Instalalo con:"
  echo "   sudo apt install python3 python3-lxml python3-pdfminer python3-pil"
  exit 1
fi

if ! python3 -c "import lxml.etree, pdfminer, PIL" 2>/dev/null; then
  echo "❌ Error: faltan módulos de Python requeridos (lxml, pdfminer o PIL). Instalalos con:"
  echo "   sudo apt install python3-lxml python3-pdfminer python3-pil"
  exit 1
fi

# --- 1. Construimos la lista de archivos a convertir --------------------------
archivos=()

saltados=0
if (( $# > 0 )); then
  for archivo in "$@"; do
    if [[ -d "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': es una carpeta, no un archivo."
      (( saltados++ ))
    elif [[ ! -f "$archivo" ]]; then
      echo "⚠️ Saltando '$archivo': no existe."
      (( saltados++ ))
    elif [[ "${(L)archivo:e}" != pdf ]]; then
      echo "⚠️ Saltando '$archivo': no es un archivo PDF (.pdf)."
      (( saltados++ ))
    else
      archivos+=("$archivo")
    fi
  done
else
  archivos=( *.(#i)pdf(N.) )
fi

# --- 2. Si no hay archivos, salimos -------------------------------------------
# Si pediste archivos y ninguno sirvió, es un error (código 1); si no pediste
# ninguno y en la carpeta no hay PDF, no hay nada que hacer (código 0).
if (( ${#archivos[@]} == 0 )); then
  echo "No se encontraron archivos PDF para convertir."
  (( saltados > 0 )) && exit 1
  exit 0
fi

# --- 3. Mostrar qué se va a convertir -----------------------------------------
echo "Se van a convertir los siguientes archivos:"
for archivo in "${archivos[@]}"; do
  echo "  - $archivo -> ${archivo:r}.md"
done

# --- 4. Pedir confirmación ----------------------------------------------------
if (( $#opcion_y )); then
  echo "Iniciando conversión..."
else
  read "respuesta?¿Continuar? [Y/n]: " || respuesta=n
  case "$respuesta" in
    y|Y|"")
      echo "Iniciando conversión..."
      ;;
    *)
      echo "Operación cancelada."
      exit 0
      ;;
  esac
fi

# --- Motor de conversión en Python --------------------------------------------
read -r -d '' CONVERTIR_PY <<'PYTHON'
