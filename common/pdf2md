fallidos=()
temporal=""
trap 'rm -f -- ${temporal:+"$temporal"}' EXIT
trap 'echo; echo "Cancelado."; exit 130' INT TERM HUP

for archivo in "${archivos[@]}"; do
  salida="${archivo:r}.md"
  temporal="$(mktemp --suffix=.md)"
  if python3 -c "$CONVERTIR_PY" "$archivo" "$temporal" && mv -f -- "$temporal" "$salida"; then
    temporal=""
    echo "✔ Generado: $salida"
  else
    rm -f -- "$temporal"
    temporal=""
    echo "❌ Error al convertir: $archivo"
    fallidos+=("$archivo")
  fi
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ No se pudieron convertir ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
