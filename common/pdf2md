# --- 5. Convertir cada archivo y mostrar mensajes -----------------------------
fallidos=()
temporal=""
trap 'rm -f -- ${temporal:+"$temporal"}' EXIT
trap 'echo; echo "Cancelado."; exit 130' INT TERM HUP

for archivo in "${archivos[@]}"; do
  salida="${archivo:r}.md"
  temporal="$(mktemp --suffix=.md)"
  # El programa va por la entrada estándar y no como argumento (-c): Linux
  # no acepta un argumento de más de 128 KiB y el programa ya es más largo.
  python3 - "$archivo" "$temporal" <<< "$CONVERTIR_PY"
  ret=$?
  # Se copia con cat (y no con mv) para que el .md tenga los permisos de
  # siempre (mktemp crea el temporal solo legible por vos) o, si ya existía,
  # conserve los suyos.
  if (( ret == 0 )) && cat -- "$temporal" > "$salida"; then
    rm -f -- "$temporal"
    temporal=""
    echo "✔ Generado: $salida"
  elif (( ret == 2 )); then
    # El archivo tenía tipografías no soportadas o sin texto legible.
    # El aviso explicativo ya fue mostrado en stderr.
    rm -f -- "$temporal"
    temporal=""
    fallidos+=("$archivo")
  else
    rm -f -- "$temporal"
    temporal=""
    echo "❌ Error al convertir: $archivo"
    fallidos+=("$archivo")
  fi
done

if (( ${#fallidos[@]} > 0 )); then
  echo "⚠️ No se pudieron convertir ${#fallidos[@]} archivo(s): ${(j:, :)fallidos}"
  exit 1
fi
echo "✅ Conversión completa."
# Algún archivo pedido se saltó (no existía o no era un PDF): código 1.
(( saltados > 0 )) && exit 1
exit 0
