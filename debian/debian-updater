#!/usr/bin/env bash
# ==============================================================================
# SCRIPT:  debian-updater
# VERSIÓN: 1.2 (basado en ubuntu-updater 2.1)
#
# DESCRIPCIÓN
#   Actualiza por completo un sistema Debian DENTRO de la versión instalada:
#   paquetes APT (incluidos el kernel y los parches de seguridad), Snap,
#   Flatpak y firmware de dispositivos (fwupd). Después limpia los paquetes
#   y runtimes que ya no se usan.
#
#   NUNCA cambia de versión de Debian (por ejemplo, de 13 "trixie" a 14
#   "forky"): solo avisa al final si hay una nueva disponible. Debian no tiene
#   un comando automático para cambiar de versión; hay que seguir las notas
#   de publicación: https://www.debian.org/releases/stable/releasenotes
#
#   Cuando sale una versión nueva, la tuya pasa de llamarse "stable" a
#   "oldstable". Si tus fuentes de APT usan el nombre clave (lo normal en
#   Debian 13: "trixie"), el script acepta ese cambio de etiqueta, que no te
#   cambia de versión, y sigue actualizando como siempre.
#
#   Si en cambio tus fuentes usan el alias "stable", aceptar el cambio SÍ te
#   pasaría a la versión nueva. En ese caso el script se detiene en el paso 1
#   y te explica cómo seguir.
#
#   En testing/unstable (sid) no hay "versiones" que conservar: es una rama
#   continua y el script simplemente la mantiene al día.
#
# USO
#   debian-updater          Modo interactivo: muestra qué se va a instalar o
#                           eliminar y pide confirmación antes de cada cambio.
#   debian-updater -y       Modo automático: instala todo sin preguntar.
#   debian-updater --help   Muestra la ayuda.
#
#   Ejecutalo como usuario normal (NO con sudo): pide la contraseña al inicio.
#   Tu usuario tiene que poder usar sudo (en Debian no siempre viene
#   configurado; ver más abajo). En modo -y sin terminal (por ejemplo, una
#   tarea programada), sudo tiene que poder ejecutarse sin contraseña.
#
# PASOS
#   0. (Si hace falta) Repara una ejecución anterior que quedó interrumpida.
#   1. Actualiza la lista de repositorios (APT).
#   2. Descarga, confirma e instala actualizaciones del sistema y kernel (APT).
#   3. Actualiza paquetes Snap.
#   4. Actualiza Flatpak (con su propia lista de cambios y confirmación).
#   5. Actualiza firmware (BIOS/UEFI, SSD, periféricos) con fwupd.
#   6. Elimina paquetes huérfanos y vacía la caché de APT.
#   7. Elimina runtimes de Flatpak que ninguna aplicación usa.
#   Al final informa errores, si hace falta reiniciar y si hay versión nueva.
#
# SEGURIDAD
#   - Ctrl+C funciona normalmente durante descargas y confirmaciones: el
#     script se detiene sin ejecutar los pasos restantes y sin dañar nada.
#   - Durante las fases críticas (cuando dpkg o fwupd modifican el sistema),
#     Ctrl+C se desactiva en la terminal y se bloquean la suspensión y el
#     apagado. Es una capa de protección adicional, no una garantía absoluta:
#     APT también maneja las interrupciones por su cuenta, y si algo quedara
#     a medias, la siguiente ejecución lo repara (paso 0).
#   - No permite dos ejecuciones simultáneas.
#
# CÓDIGOS DE SALIDA
#   0    Se completó correctamente (aunque hayas omitido algún paso).
#   1    Algún paso falló, o no se pudo comenzar (red, permisos, etc.).
#   2    Uso incorrecto (opción desconocida, o falta -y sin terminal).
#   130  Interrumpido por el usuario (Ctrl+C) o por una señal del sistema.
#
# DEPENDENCIAS
#   Requeridas: bash 4.4+, apt-get, dpkg, sudo, flock, timeout.
#               Todas vienen con Debian salvo, a veces, sudo. Si no lo tenés:
#                 su - -c 'apt install sudo && adduser TU_USUARIO sudo'
#               y después cerrá sesión y volvé a entrar.
#   Opcionales: snap, flatpak, fwupdmgr, systemd-inhibit, curl o wget
#               (para avisar si hay una versión nueva de Debian).
#               Si alguna no está instalada, su paso se omite.
# ==============================================================================

set -uo pipefail

# ------------------------------------------------------------------------------
# CONFIGURACIÓN (editable)
# ------------------------------------------------------------------------------

# Repositorio usado para verificar la conexión y consultar cuál es la versión
# estable actual de Debian. Cambialo si usás un mirror propio (tiene que
# servir por HTTP en el puerto 80).
REPO_URL="http://deb.debian.org/debian"

# Solo en modo -y. Si modificaste un archivo de configuración del sistema y
# el paquete nuevo trae otra versión de ese archivo:
#   1 = conservar siempre tu versión sin preguntar (recomendado).
#   0 = que APT pregunte igual (el modo -y deja de ser 100 % desatendido).
KEEP_CONFIG_ON_YES=1

# ------------------------------------------------------------------------------
# ESTADO INTERNO (no editar)
# ------------------------------------------------------------------------------
ASSUME_YES=0     # 1 si se usó -y / --yes
FAILED=()        # pasos que fallaron
SKIPPED=()       # pasos que el usuario decidió omitir
KEEPALIVE_PID="" # proceso que mantiene activo sudo
STTY_SAVED=""    # configuración original de la terminal
FW_UPDATED=0     # 1 si se instaló firmware (requiere reinicio)
DEB_ROLLING=0    # 1 si las fuentes siguen testing/unstable
DEB_ALIAS=0      # 1 si las fuentes usan el alias "stable"/"oldstable"

REPO_HOST=${REPO_URL#*://}
REPO_HOST=${REPO_HOST%%/*}

# Datos de la versión instalada (de /etc/os-release)
OS_ID="" OS_VERSION_ID="" OS_CODENAME=""
if [[ -r /etc/os-release ]]; then
	OS_ID=$(. /etc/os-release && echo "${ID:-}")
	OS_VERSION_ID=$(. /etc/os-release && echo "${VERSION_ID:-}")
	OS_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-}")
fi

# ------------------------------------------------------------------------------
# SALIDA EN PANTALLA (colores solo si la salida es una terminal)
# ------------------------------------------------------------------------------
if [[ -t 1 ]]; then
	CYAN=$'\033[0;36m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m' RED=$'\033[0;31m' NC=$'\033[0m'
else
	CYAN='' GREEN='' YELLOW='' RED='' NC=''
fi

info() { printf '%s%s%s\n' "$CYAN" "$*" "$NC"; }
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$NC"; }
error() { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; }

# Une sus argumentos separados por coma: "a, b, c"
join_list() {
	local out
	printf -v out '%s, ' "$@"
	printf '%s' "${out%, }"
}

usage() {
	cat <<'EOF'
Uso: debian-updater [-y] [-h]

Actualiza Debian por completo (APT y kernel, Snap, Flatpak y firmware) sin
cambiar de versión. Si hay una versión nueva de Debian, solo lo avisa.

Opciones:
  -y, --yes    Instala todo sin pedir confirmación (modo automático).
  -h, --help   Muestra esta ayuda.

Sin opciones, muestra qué se va a instalar o eliminar y pide confirmación.
Ejecutalo como usuario normal, no con sudo.
EOF
}

# ------------------------------------------------------------------------------
# OPCIONES DE LÍNEA DE COMANDOS
# ------------------------------------------------------------------------------
while (($# > 0)); do
	case $1 in
	-y | --yes) ASSUME_YES=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		error "❌ Opción desconocida: $1"
		echo "Usá 'debian-updater --help' para ver las opciones." >&2
		exit 2
		;;
	esac
	shift
done

# ------------------------------------------------------------------------------
# OPCIONES DE APT Y DPKG SEGÚN LA CONFIGURACIÓN Y EL MODO
# ------------------------------------------------------------------------------
# Esperar hasta 2 minutos si otro proceso (p. ej. unattended-upgrades) usa APT
APT_OPTS=(-o DPkg::Lock::Timeout=120)

# En modo -y: sin diálogos de configuración (debconf), de reinicio de
# servicios (needrestart) ni de novedades de paquetes (apt-listchanges), y
# opcionalmente conservando la configuración propia.
NONINTERACTIVE=()
DPKG_CONF_OPTS=()
if ((ASSUME_YES)); then
	NONINTERACTIVE=(env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
		APT_LISTCHANGES_FRONTEND=none)
	if ((KEEP_CONFIG_ON_YES)); then
		DPKG_CONF_OPTS=(--force-confdef --force-confold)
		APT_OPTS+=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
	fi
fi
APT_CMD=("${NONINTERACTIVE[@]}" apt-get)

# ------------------------------------------------------------------------------
# LIMPIEZA AL SALIR Y MANEJO DE INTERRUPCIONES
# ------------------------------------------------------------------------------
# Carpeta temporal para guardar los mensajes de error de algunos comandos
TMP_DIR=$(mktemp -d)

# Se ejecuta siempre al terminar, sea como sea: restaura la terminal,
# detiene el proceso que mantiene activo sudo y borra la carpeta temporal.
cleanup() {
	if [[ -n $STTY_SAVED ]]; then
		stty "$STTY_SAVED" 2>/dev/null
	fi
	if [[ -n $KEEPALIVE_PID ]]; then
		kill "$KEEPALIVE_PID" 2>/dev/null
	fi
	rm -rf "$TMP_DIR"
}

# Ctrl+C (fuera de fases críticas), cierre de terminal o kill: se detiene
# después del comando en curso, sin ejecutar los pasos restantes.
on_signal() {
	trap '' INT TERM HUP # evitar reentradas si se insiste con Ctrl+C
	echo
	warn "🛑 Ejecución interrumpida. No se continuará con los pasos restantes."
	if [[ -n $(dpkg --audit 2>/dev/null) ]]; then
		warn "   APT quedó a medias. Volvé a ejecutar debian-updater: lo reparará automáticamente."
	fi
	exit 130
}

trap cleanup EXIT
trap on_signal INT TERM HUP

# Si un comando terminó por Ctrl+C (código 130), detiene el script. Hace que
# la interrupción funcione aunque la señal le llegue solo al comando (por
# ejemplo, a uno que se ejecuta con sudo) y no a este script.
stop_if_interrupted() {
	if (($1 == 130)); then
		on_signal
	fi
}

# ------------------------------------------------------------------------------
# FUNCIONES AUXILIARES
# ------------------------------------------------------------------------------
# Ejecuta un comando; si falla, lo registra en FAILED y devuelve 1 sin
# detener el script (para que los demás pasos puedan seguir). Si el comando
# fue interrumpido con Ctrl+C, detiene el script.
run() {
	local desc=$1 rc=0
	shift
	"$@" || rc=$?
	stop_if_interrupted "$rc"
	if ((rc != 0)); then
		error "❌ Falló: $desc"
		FAILED+=("$desc")
		return 1
	fi
}

# Pide confirmación [S/n] (Enter = sí). En modo -y responde "sí" solo.
confirm() {
	if ((ASSUME_YES)); then
		return 0
	fi
	local ans
	read -r -p "${YELLOW}   $1 [S/n] ${NC}" ans || return 1
	[[ -z $ans || $ans =~ ^[sSyY] ]]
}

# Cuenta cuántos paquetes cambiaría una operación de APT (simulación: no
# modifica nada y no necesita root). Si APT no puede calcularla (por
# ejemplo, por dependencias rotas), muestra el error y devuelve 1.
apt_pending() {
	local out
	if ! out=$(LC_ALL=C apt-get "${APT_OPTS[@]}" -s "$@" 2>&1); then
		sed 's/^/   /' <<<"$out" >&2
		return 1
	fi
	grep -cE '^(Inst|Remv|Purg) ' <<<"$out" || true
}

# Ejecuta un comando con su salida de siempre en la terminal (idioma,
# colores, barras de progreso) y guarda además una copia de sus mensajes de
# error en el archivo indicado, para poder analizarlos después. Solo los
# errores pasan por tee: la salida normal va directo a la terminal, así el
# comando sabe que está en una y muestra su interfaz completa.
run_keep_errors() {
	local errfile=$1
	shift
	{ "$@" 2>&1 1>&3 3>&- | tee "$errfile" >&2; } 3>&1
}

# Ejecuta un comando de Flatpak con su interfaz de siempre. En modo
# interactivo, Flatpak muestra la lista de cambios y pide su propia
# confirmación; solo con -y acepta todo sin preguntar.
#   Uso: run_flatpak "descripción" "nombre si se omite" subcomando [args...]
# Si rechazás la confirmación, Flatpak termina con código de error pero sin
# ningún mensaje (un fallo real siempre muestra uno): eso se registra como
# omitido, no como fallo.
run_flatpak() {
	local desc=$1 skip_name=$2 rc=0 yes=()
	shift 2
	if ((ASSUME_YES)); then
		yes=(-y)
	fi
	run_keep_errors "$TMP_DIR/flatpak.err" flatpak "$@" "${yes[@]}" || rc=$?
	stop_if_interrupted "$rc"
	if ((rc == 0)); then
		return 0
	fi
	if grep -qi 'error' "$TMP_DIR/flatpak.err"; then
		error "❌ Falló: $desc"
		FAILED+=("$desc")
	else
		warn "   Omitido: $skip_name."
		SKIPPED+=("$skip_name")
	fi
	return 1
}

# Clasifica las actualizaciones de firmware que ofrece fwupd (recibe el JSON
# de "fwupdmgr get-updates --json") e imprime una línea por dispositivo:
#   OK|BLOQUEADA <tab> nombre <tab> versión actual <tab> versión nueva <tab> motivo
# BLOQUEADA = fwupd la ofrece pero no puede instalarla en este equipo (el
# dispositivo tiene un error de actualización, y fwupd la saltea en silencio).
fw_classify() {
	python3 -c '
import json, sys
try:
    devices = json.load(sys.stdin).get("Devices", [])
except ValueError:
    sys.exit(1)
for d in devices:
    releases = d.get("Releases") or []
    if not releases:
        continue
    why = d.get("UpdateError", "")
    print("\t".join([
        "BLOQUEADA" if why else "OK",
        d.get("Name", "?"),
        d.get("Version", "?"),
        releases[0].get("Version", "?"),
        why,
    ]))
'
}

# Pide confirmación e instala las actualizaciones de firmware (fase crítica).
# La pregunta la hace confirm() (en modo -y responde "sí" sola). El -y de
# fwupdmgr es para que fwupd no vuelva a preguntar ya dentro de la fase
# crítica, donde Ctrl+C está desactivado. APT hace lo mismo en el paso 2.
fw_install() {
	if confirm "¿Instalar estas actualizaciones de firmware?"; then
		critical "fwupdmgr update" \
			fwupdmgr update -y --no-reboot-check --no-unreported-check && FW_UPDATED=1
	else
		SKIPPED+=("firmware")
	fi
}

# Lista las ramas de Debian que usan tus fuentes, tal como están escritas
# (trixie, stable, sid...), sin sufijos como -updates o -security. Solo
# considera repositorios oficiales de Debian (Origin: Debian), así un
# repositorio de terceros llamado "stable" no confunde la detección.
debian_suites() {
	LC_ALL=C apt-cache policy 2>/dev/null | awk '
		/^ *-?[0-9]+ / { split($3, a, "/"); dist = a[1]; next }
		/release .*o=Debian,/ && dist != "" { print dist }' |
		sed 's/-.*//' | sort -u
}

# Extrae el tipo de kernel de su nombre: "6.12.48+deb13-amd64" → "amd64",
# "6.12.48+deb13-rt-amd64" → "rt-amd64", "6.1.0-25-amd64" → "amd64".
kernel_flavor() { sed -E 's/^[0-9.]+(\+deb[0-9]+|-[0-9]+)-//' <<<"$1"; }

# Devuelve 0 si hace falta reiniciar para usar el kernel instalado y deja el
# motivo en KERNEL_REASON. (Debian no crea /run/reboot-required por su
# cuenta como Ubuntu.) Detecta dos casos:
#   a) Se instaló un kernel más nuevo del mismo tipo que el que está en uso.
#   b) El paquete del kernel en uso se actualizó sin cambiar de nombre (pasa
#      con algunas correcciones de seguridad): se compara la compilación en
#      memoria (uname -v) con la versión instalada del paquete.
KERNEL_REASON=""
kernel_reboot_needed() {
	local running flavor k name list="" newest pkg built installed
	running=$(uname -r)
	flavor=$(kernel_flavor "$running")
	for k in /boot/vmlinuz-*; do
		[[ -e $k ]] || continue
		name=${k#/boot/vmlinuz-}
		if [[ $(kernel_flavor "$name") == "$flavor" ]]; then
			list+="$name"$'\n'
		fi
	done
	newest=$(sed '/^$/d' <<<"$list" | sort -V | tail -n1)
	if [[ -n $newest && $newest != "$running" ]]; then
		KERNEL_REASON="Hay un kernel más nuevo instalado ($newest); estás usando $running."
		return 0
	fi

	built=$(uname -v | sed -n 's/.* Debian \([^ ]*\) .*/\1/p')
	pkg=$(dpkg-query -S "/boot/vmlinuz-$running" 2>/dev/null | cut -d: -f1)
	if [[ -n $built && -n $pkg ]]; then
		installed=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null)
		if [[ -n $installed && $installed != "$built" ]]; then
			KERNEL_REASON="El kernel en uso se actualizó ($built → $installed)."
			return 0
		fi
	fi
	return 1
}

# Guardar la configuración de la terminal (solo si hay una terminal real)
if [[ -t 0 ]]; then
	STTY_SAVED=$(stty -g)
fi

# Desactivar / restaurar Ctrl+C, Ctrl+Z y Ctrl+\ en la terminal
shield_on() { if [[ -n $STTY_SAVED ]]; then stty -isig; fi; }
shield_off() { if [[ -n $STTY_SAVED ]]; then stty "$STTY_SAVED"; fi; }

# Bloquear suspensión, apagado y cierre de tapa durante las fases críticas
INHIBIT=()
if command -v systemd-inhibit >/dev/null; then
	INHIBIT=(systemd-inhibit --what=shutdown:sleep:idle:handle-lid-switch
		--who=debian-updater --why="Instalando actualizaciones")
fi

# Ejecuta como root un paso que modifica el sistema y NO debe interrumpirse:
# sin Ctrl+C, sin suspensión ni apagado mientras dure.
critical() {
	local desc=$1
	shift
	warn "   🔒 Fase crítica: Ctrl+C desactivado hasta que termine este paso."
	shield_on
	run "$desc" sudo "${INHIBIT[@]}" "$@"
	local rc=$?
	shield_off
	return "$rc"
}

# Solo CONSULTA si hay una versión estable de Debian más nueva que la
# instalada; nunca la instala. Lee el archivo Release de "stable" en el
# repositorio y compara su número de versión con el de /etc/os-release.
check_new_release() {
	# testing/sid no tienen número de versión: no hay nada que comparar
	if ((DEB_ROLLING)) || [[ ! ${OS_VERSION_ID%%.*} =~ ^[0-9]+$ ]]; then
		return 0
	fi
	info "🔎 Buscando nuevas versiones de Debian..."
	local url="$REPO_URL/dists/stable/Release" rel=""
	if command -v curl >/dev/null; then
		rel=$(curl -fsSL --max-time 30 "$url" 2>/dev/null)
	elif command -v wget >/dev/null; then
		rel=$(timeout 30 wget -qO- "$url" 2>/dev/null)
	else
		info "   Instalá curl o wget para poder comprobarlo."
		return 0
	fi

	local codename version major
	codename=$(sed -n 's/^Codename: //p' <<<"$rel")
	version=$(sed -n 's/^Version: //p' <<<"$rel")
	major=${version%%.*}
	if [[ ! $major =~ ^[0-9]+$ ]]; then
		warn "   No se pudo consultar la versión estable actual."
		return 0
	fi

	if ((major > ${OS_VERSION_ID%%.*})); then
		echo
		warn "🆕 Hay una nueva versión de Debian disponible: $major \"$codename\""
		warn "   (tenés Debian $OS_VERSION_ID \"${OS_CODENAME:-?}\")."
		warn "   Este script NO la instala. Para actualizar, seguí las notas de publicación:"
		warn "   https://www.debian.org/releases/stable/releasenotes"
	else
		info "   Estás en la versión estable actual (Debian $OS_VERSION_ID \"${OS_CODENAME:-?}\")."
	fi

	if ((DEB_ALIAS)); then
		echo
		warn "ℹ️  Tus fuentes de APT usan el alias \"stable\" en lugar de \"${OS_CODENAME:-el nombre clave}\"."
		warn "   Cuando salga una versión nueva, este script se detendrá en el paso 1"
		warn "   (no la instala solo). Para evitarlo, reemplazá \"stable\" por"
		warn "   \"${OS_CODENAME:-el nombre clave}\" en /etc/apt/sources.list o /etc/apt/sources.list.d/."
	fi
}

# ==============================================================================
# COMPROBACIONES PREVIAS
# ==============================================================================
if [[ $EUID -eq 0 ]]; then
	error "❌ Ejecutalo como usuario normal (sin sudo); pedirá permisos cuando haga falta."
	exit 1
fi

if [[ $OS_ID != debian ]]; then
	warn "⚠️  Este script está pensado para Debian (sistema detectado: ${OS_ID:-desconocido})."
fi

if ((! ASSUME_YES)) && [[ ! -t 0 ]]; then
	error "❌ No hay una terminal para pedir confirmación. Usá 'debian-updater -y'."
	exit 2
fi

if ! command -v sudo >/dev/null; then
	error "❌ sudo no está instalado. Instalalo como root y agregá tu usuario al grupo sudo:"
	error "   su - -c 'apt install sudo && adduser ${USER:-$(id -un)} sudo'"
	error "   Después cerrá sesión, volvé a entrar y ejecutá de nuevo este script."
	exit 1
fi

# Impedir dos ejecuciones simultáneas
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/debian-updater.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
	error "❌ debian-updater ya se está ejecutando en otra terminal."
	exit 1
fi

if ((ASSUME_YES)); then
	info "⚙️  Modo automático (-y): se instalará todo sin preguntar."
else
	info "⚙️  Modo interactivo: se pedirá confirmación antes de cada cambio."
fi

info "🌐 Verificando conexión con $REPO_HOST..."
if ! timeout 5 bash -c "exec 3<>/dev/tcp/$REPO_HOST/80" 2>/dev/null; then
	error "❌ No se puede llegar a $REPO_HOST. Revisá tu red o DNS."
	exit 1
fi

info "🔐 Solicitando permisos de administrador..."
if ! sudo -v; then
	error "❌ No se pudieron obtener permisos de administrador."
	error "   ¿Tu usuario está en el grupo sudo? Como root: adduser ${USER:-$(id -un)} sudo"
	exit 1
fi

# Mantener vigente la autorización de sudo mientras dure el script.
# "sudo -n -v" solo renueva la autorización, sin ejecutar ningún comando.
# (9>&- evita que este proceso herede el bloqueo de ejecución única.)
(while kill -0 "$$" 2>/dev/null; do
	sudo -n -v 2>/dev/null
	sleep 50
done) 9>&- </dev/null &
KEEPALIVE_PID=$!

# ==============================================================================
# PASO 0: REPARAR UNA EJECUCIÓN ANTERIOR INTERRUMPIDA
# ==============================================================================
# Se hace sin preguntar: solo termina de configurar lo que ya estaba a medias.
if [[ -n $(dpkg --audit 2>/dev/null) ]]; then
	warn "⚠️  Se detectó una instalación anterior interrumpida. Reparando..."
	if ! critical "dpkg --configure -a" \
		"${NONINTERACTIVE[@]}" dpkg "${DPKG_CONF_OPTS[@]}" --configure -a ||
		! critical "apt-get -f install" "${APT_CMD[@]}" "${APT_OPTS[@]}" -f install -y; then
		error "   No se pudo reparar el sistema de paquetes. Revisalo manualmente antes de continuar."
		exit 1
	fi
fi

# ==============================================================================
# PASO 1: LISTA DE REPOSITORIOS
# ==============================================================================
# Cuando sale una Debian nueva, APT exige confirmar los cambios en los datos
# de cada repositorio:
#   - Cambio de etiqueta (Suite: "stable" → "oldstable") con fuentes que usan
#     el nombre clave ("trixie"): se acepta solo, porque seguís en la misma
#     versión (--allow-releaseinfo-change-suite).
#   - Cambio de nombre clave (Codename: "trixie" → "forky") con fuentes que
#     usan el alias "stable": NO se acepta, porque implicaría cambiar de
#     versión. APT falla y el script explica cómo seguir.
echo
info "🔄 1/7 - Actualizando lista de repositorios (APT)..."
upd_rc=0
run_keep_errors "$TMP_DIR/apt-update.err" sudo "${APT_CMD[@]}" "${APT_OPTS[@]}" update \
	--error-on=any --allow-releaseinfo-change-suite || upd_rc=$?
stop_if_interrupted "$upd_rc"
if ((upd_rc != 0)); then
	error "❌ Falló: apt-get update"
	# El nombre del campo "Codename" aparece igual en cualquier idioma
	if grep -q 'Codename' "$TMP_DIR/apt-update.err"; then
		echo
		warn "   Un repositorio cambió de versión (el detalle está en el error de arriba)."
		warn "   Lo más probable es que haya salido una nueva versión de Debian y tus"
		warn "   fuentes usen \"stable\" en lugar del nombre clave. El script no acepta"
		warn "   ese cambio porque implicaría pasar a la versión nueva."
		warn "   • Para quedarte en tu versión: reemplazá \"stable\" por \"${OS_CODENAME:-tu nombre clave}\""
		warn "     en /etc/apt/sources.list o /etc/apt/sources.list.d/ y volvé a ejecutarlo."
		warn "   • Para cambiar de versión: seguí las notas de publicación:"
		warn "     https://www.debian.org/releases/stable/releasenotes"
	fi
	error "   Sin índices actualizados no tiene sentido continuar."
	exit 1
fi

# Detectar qué ramas siguen las fuentes (para los avisos finales)
mapfile -t suites < <(debian_suites)
for s in "${suites[@]}"; do
	case $s in
	testing | unstable | sid | experimental) DEB_ROLLING=1 ;;
	stable | oldstable | oldoldstable) DEB_ALIAS=1 ;;
	esac
done
if ((DEB_ROLLING)); then
	info "   ℹ️  Tus fuentes siguen testing/unstable: es una rama continua y las"
	info "      actualizaciones pueden traer cambios grandes. Revisá bien la lista."
fi

# ==============================================================================
# PASO 2: SISTEMA Y KERNEL (APT)
# ==============================================================================
# Se divide en dos etapas: primero se DESCARGA todo (interrumpible, el
# sistema no cambia) y, tras confirmar, se INSTALA (fase crítica).
echo
info "📦 2/7 - Actualizaciones del sistema y kernel (APT)..."
upgrade_ok=1
upgrade_declined=0
if ! pending=$(apt_pending full-upgrade); then
	error "❌ APT no puede calcular la actualización (ver el error de arriba)."
	FAILED+=("apt-get full-upgrade (cálculo)")
	upgrade_ok=0
elif ((pending == 0)); then
	info "   No hay actualizaciones pendientes."
else
	info "   Descargando $pending cambio(s). Ctrl+C permitido: el sistema todavía no cambia."
	if ! run "apt-get full-upgrade (descarga)" \
		sudo "${APT_CMD[@]}" "${APT_OPTS[@]}" full-upgrade --download-only -y; then
		upgrade_ok=0
	elif confirm "¿Instalar los cambios listados arriba?"; then
		critical "apt-get full-upgrade" "${APT_CMD[@]}" "${APT_OPTS[@]}" full-upgrade -y || upgrade_ok=0
	else
		warn "   Instalación de APT omitida. Lo descargado queda en caché para la próxima vez."
		SKIPPED+=("actualizaciones de APT")
		upgrade_declined=1
	fi
fi

# ==============================================================================
# PASO 3: SNAP
# ==============================================================================
# Se ejecuta si snapd está instalado (en Debian no viene de serie).
# Interrumpir es seguro: el servicio snapd termina el trabajo por su cuenta.
echo
if command -v snap >/dev/null; then
	info "🔄 3/7 - Paquetes Snap..."
	snap_rc=0
	snap_list=$(LC_ALL=C snap refresh --list 2>&1) || snap_rc=$?
	stop_if_interrupted "$snap_rc"
	if ((snap_rc != 0)); then
		error "❌ Falló: snap refresh --list"
		sed 's/^/   /' <<<"$snap_list" >&2
		FAILED+=("snap refresh --list")
	elif ! grep -q '^Name' <<<"$snap_list"; then
		info "   Todos los Snap están al día."
	else
		sed 's/^/   /' <<<"$snap_list"
		if confirm "¿Actualizar estos Snap?"; then
			run "snap refresh" sudo snap refresh
		else
			SKIPPED+=("Snap")
		fi
	fi
else
	info "⏭️  3/7 - Snap no está instalado. Omitiendo..."
fi

# ==============================================================================
# PASO 4: FLATPAK
# ==============================================================================
# Flatpak se ejecuta directamente en la terminal, con su interfaz de siempre:
# muestra la lista de cambios, pide confirmación (salvo en modo -y) y muestra
# el progreso. Interrumpir es seguro: aplica cada actualización de forma
# atómica.
echo
if command -v flatpak >/dev/null; then
	info "📦 4/7 - Paquetes Flatpak..."
	run_flatpak "flatpak update" "actualizaciones de Flatpak" update
else
	info "⏭️  4/7 - Flatpak no está instalado. Omitiendo..."
fi

# ==============================================================================
# PASO 5: FIRMWARE (fwupd)
# ==============================================================================
# fwupd no separa descarga e instalación, así que toda la actualización es
# fase crítica. Nunca reinicia solo: si instala algo, se avisa al final.
#
# fwupd a veces ofrece actualizaciones que no puede instalar en este equipo
# (por ejemplo, las de Secure Boot cuando el firmware no informa su espacio
# libre) y al "instalarlas" las saltea sin avisar. Por eso se separan: solo
# se pregunta por las que se pueden instalar, y las otras se muestran aparte.
#
# --no-unreported-check evita la pregunta sobre enviar informes a LVFS, y
# </dev/null impide que las consultas esperen una respuesta del teclado.
echo
if command -v fwupdmgr >/dev/null; then
	info "🔌 5/7 - Firmware de dispositivos (fwupd)..."
	fw_rc=0
	sudo fwupdmgr refresh --force </dev/null >/dev/null 2>&1 || fw_rc=$?
	stop_if_interrupted "$fw_rc"
	fw_rc=0
	fw_json=$(sudo fwupdmgr get-updates --json --no-unreported-check </dev/null 2>/dev/null) || fw_rc=$?
	stop_if_interrupted "$fw_rc"
	case $fw_rc in
	0)
		if command -v python3 >/dev/null && fw_rows=$(fw_classify <<<"$fw_json"); then
			fw_ok=() fw_blocked=()
			while IFS=$'\t' read -r state name cur new why; do
				[[ -n $state ]] || continue
				if [[ $state == OK ]]; then
					fw_ok+=("$name: $cur → $new")
				else
					fw_blocked+=("$name: $cur → $new ($why)")
				fi
			done <<<"$fw_rows"
			if ((${#fw_ok[@]} > 0)); then
				info "   Actualizaciones disponibles:"
				printf '   • %s\n' "${fw_ok[@]}"
			fi
			if ((${#fw_blocked[@]} > 0)); then
				warn "   fwupd ofrece estas actualizaciones, pero no puede instalarlas en este equipo:"
				printf '   • %s\n' "${fw_blocked[@]}"
			fi
			if ((${#fw_ok[@]} > 0)); then
				fw_install
			else
				info "   No hay actualizaciones de firmware que se puedan instalar."
			fi
		else
			# Sin python3 no se puede saber cuáles se pueden instalar: se
			# muestra la lista completa de fwupd.
			sudo fwupdmgr get-updates --no-unreported-check </dev/null 2>/dev/null | sed 's/^/   /'
			fw_install
		fi
		;;
	2) info "   El firmware está al día (o no hay dispositivos compatibles)." ;;
	*) warn "   No se pudo consultar el firmware. Omitiendo..." ;;
	esac
else
	info "⏭️  5/7 - fwupd no está instalado. Omitiendo..."
fi

# ==============================================================================
# PASO 6: LIMPIEZA DE APT
# ==============================================================================
echo
if ((! upgrade_ok)); then
	warn "⏭️  6/7 - Omitido: la actualización de APT falló y no conviene quitar paquetes."
else
	info "🧹 6/7 - Limpieza de APT..."
	mapfile -t orphans < <(LC_ALL=C apt-get -s autoremove --purge 2>/dev/null |
		awk '/^(Purg|Remv) / {print $2}')
	if ((${#orphans[@]} == 0)); then
		info "   No hay paquetes huérfanos."
	else
		info "   Paquetes que ya no se necesitan:"
		printf '   • %s\n' "${orphans[@]}"
		if confirm "¿Eliminarlos?"; then
			critical "apt-get autoremove" "${APT_CMD[@]}" "${APT_OPTS[@]}" autoremove --purge -y
		else
			SKIPPED+=("eliminación de huérfanos")
		fi
	fi

	# Si se rechazó la instalación, conservar la descarga para la próxima vez
	if ((upgrade_declined)); then
		info "   Se conserva la caché de APT (contiene la descarga pendiente)."
	else
		run "apt-get clean" sudo apt-get "${APT_OPTS[@]}" clean
	fi
fi

# ==============================================================================
# PASO 7: LIMPIEZA DE FLATPAK
# ==============================================================================
# Quita runtimes que ninguna app instalada usa. Igual que en el paso 4,
# Flatpak muestra la lista y pide confirmación, salvo en modo -y.
echo
if command -v flatpak >/dev/null; then
	info "🧹 7/7 - Eliminando runtimes sin uso (Flatpak)..."
	run_flatpak "flatpak remove --unused" "limpieza de Flatpak" remove --unused
else
	info "⏭️  7/7 - Flatpak no está instalado. Omitiendo limpieza..."
fi

# ==============================================================================
# RESUMEN FINAL
# ==============================================================================
echo
if ((${#FAILED[@]} > 0)); then
	warn "⚠️  Terminó con errores en: $(join_list "${FAILED[@]}")"
	status=1
elif ((${#SKIPPED[@]} > 0)); then
	printf '%s✅ Proceso completado. Omitiste: %s%s\n' "$GREEN" "$(join_list "${SKIPPED[@]}")" "$NC"
	status=0
else
	printf '%s✅ ¡Sistema actualizado y limpio!%s\n' "$GREEN" "$NC"
	status=0
fi

kernel_new=0
kernel_reboot_needed && kernel_new=1
if [[ -f /run/reboot-required ]] || ((kernel_new || FW_UPDATED)); then
	echo
	warn "⚠️  Se recomienda reiniciar el sistema."
	if ((kernel_new)); then
		warn "   $KERNEL_REASON"
	fi
	if [[ -f /run/reboot-required.pkgs ]]; then
		warn "   Paquetes que lo requieren:"
		sort -u /run/reboot-required.pkgs | sed 's/^/   • /'
	fi
	if ((FW_UPDATED)); then
		warn "   Se actualizó firmware: algunos dispositivos lo aplican al reiniciar, y otros"
		warn "   (como algunos SSD) recién al apagar y volver a prender."
	fi
fi

echo
check_new_release

exit "$status"
