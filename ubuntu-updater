#!/usr/bin/env bash
# ==============================================================================
# SCRIPT: ubuntu-updater
# DESCRIPCIÓN:
#   Actualización completa de Ubuntu DENTRO de la versión instalada:
#   paquetes APT (incluido el kernel), Snap, Flatpak y firmware (fwupd).
#   NUNCA cambia de versión de Ubuntu: solo avisa si hay una nueva.
#   - Verifica conectividad real con el repositorio (DNS + TCP).
#   - Impide ejecuciones simultáneas (flock).
#   - Repara automáticamente instalaciones previas interrumpidas.
#   - Protege las fases críticas de Ctrl+C, suspensión y apagado.
#   - Ante Ctrl+C fuera de las fases críticas, se detiene limpiamente.
#   - Registra los pasos fallidos y devuelve un código de salida correcto.
#   - Informa si hace falta reiniciar y por qué.
# USO: ubuntu-updater   (como usuario normal, NO con sudo)
# ==============================================================================

set -uo pipefail

# ---------- Configuración ----------
REPO_HOST="archive.ubuntu.com" # cambialo si usás un mirror propio

# 1 = instalar también las actualizaciones "en fases" antes de que Ubuntu
#     las libere para tu equipo. Recomendado: 0 (las de seguridad no esperan).
INCLUDE_PHASED=0

APT_OPTS=(-o DPkg::Lock::Timeout=120)
if ((INCLUDE_PHASED)); then
	APT_OPTS+=(-o APT::Get::Always-Include-Phased-Updates=true)
fi

FAILED=()
KEEPALIVE_PID=""
STTY_SAVED=""
FW_UPDATED=0

# ---------- Presentación ----------
if [[ -t 1 ]]; then
	CYAN=$'\033[0;36m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m' RED=$'\033[0;31m' NC=$'\033[0m'
else
	CYAN='' GREEN='' YELLOW='' RED='' NC=''
fi

info() { printf '%s%s%s\n' "$CYAN" "$*" "$NC"; }
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$NC"; }
error() { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; }

# ---------- Limpieza y manejo de señales ----------
cleanup() {
	if [[ -n $STTY_SAVED ]]; then
		stty "$STTY_SAVED" 2>/dev/null
	fi
	if [[ -n $KEEPALIVE_PID ]]; then
		kill "$KEEPALIVE_PID" 2>/dev/null
	fi
}

on_signal() {
	trap '' INT TERM HUP # evitar reentradas si se insiste con Ctrl+C
	echo
	warn "🛑 Ejecución interrumpida. No se continuará con los pasos restantes."
	if [[ -n $(dpkg --audit 2>/dev/null) ]]; then
		warn "   APT quedó a medias. Volvé a ejecutar ubuntu-updater: lo reparará automáticamente."
	fi
	exit 130
}

trap cleanup EXIT
trap on_signal INT TERM HUP

# ---------- Utilidades ----------
# Ejecuta un comando; si falla, lo registra y devuelve 1 sin abortar el script
run() {
	local desc=$1
	shift
	if ! "$@"; then
		error "❌ Falló: $desc"
		FAILED+=("$desc")
		return 1
	fi
}

# Guardar el estado de la terminal (solo si hay una terminal real)
if [[ -t 0 ]]; then
	STTY_SAVED=$(stty -g)
fi

shield_on() { if [[ -n $STTY_SAVED ]]; then stty -isig; fi; }
shield_off() { if [[ -n $STTY_SAVED ]]; then stty "$STTY_SAVED"; fi; }

# Bloquear suspensión, apagado y cierre de tapa durante las fases críticas
INHIBIT=()
if command -v systemd-inhibit >/dev/null; then
	INHIBIT=(systemd-inhibit --what=shutdown:sleep:idle:handle-lid-switch
		--who=ubuntu-updater --why="Instalando actualizaciones")
fi

# Ejecuta un paso crítico como root: sin Ctrl+C, sin suspensión ni apagado
critical() {
	local desc=$1
	shift
	warn "   🔒 Fase crítica: Ctrl+C desactivado hasta que termine este paso."
	shield_on
	run "$desc" sudo "${INHIBIT[@]}" "$@"
	local rc=$?
	shield_off
	return "$rc"
}

# Solo CONSULTA si hay una versión nueva de Ubuntu; nunca la instala
check_new_release() {
	command -v do-release-upgrade >/dev/null || return 0
	info "🔎 Buscando nuevas versiones de Ubuntu..."
	local out ver
	if ! out=$(LC_ALL=C timeout 60 do-release-upgrade -c 2>/dev/null); then
		info "   No hay una versión nueva disponible según tu configuración."
		return 0
	fi
	ver=$(sed -n "s/^New release '\([^']*\)' available.*/\1/p" <<<"$out")
	echo
	warn "🆕 Hay una nueva versión de Ubuntu disponible: ${ver:-(sin detalle)}"
	warn "   Este script NO la instala. Cuando quieras actualizar: sudo do-release-upgrade"
}

# ---------- Comprobaciones previas ----------
if [[ $EUID -eq 0 ]]; then
	error "❌ Ejecutalo como usuario normal (sin sudo); pedirá permisos cuando haga falta."
	exit 1
fi

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/ubuntu-updater.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
	error "❌ ubuntu-updater ya se está ejecutando en otra terminal."
	exit 1
fi

info "🌐 Verificando conexión con $REPO_HOST..."
if ! timeout 5 bash -c "exec 3<>/dev/tcp/$REPO_HOST/80" 2>/dev/null; then
	error "❌ No se puede llegar a $REPO_HOST. Revisá tu red o DNS."
	exit 1
fi

info "🔐 Solicitando permisos de administrador..."
if ! sudo -v; then
	error "❌ No se pudieron obtener permisos de administrador."
	exit 1
fi

# Keep-alive de sudo (sin heredar el lock); se elimina en cleanup()
(while kill -0 "$$" 2>/dev/null; do
	sudo -n true 2>/dev/null
	sleep 50
done) 9>&- &
KEEPALIVE_PID=$!

# ---------- Reparación de ejecuciones interrumpidas ----------
if [[ -n $(dpkg --audit 2>/dev/null) ]]; then
	warn "⚠️  Se detectó una instalación anterior interrumpida. Reparando..."
	if ! critical "dpkg --configure -a" dpkg --configure -a ||
		! critical "apt-get -f install" apt-get "${APT_OPTS[@]}" -f install -y; then
		error "   No se pudo reparar el sistema de paquetes. Revisalo manualmente antes de continuar."
		exit 1
	fi
fi

# ---------- Actualización ----------
echo
info "🔄 1/7 - Actualizando lista de repositorios (APT)..."
if ! run "apt-get update" sudo apt-get "${APT_OPTS[@]}" update --error-on=any; then
	error "   Sin índices actualizados no tiene sentido continuar."
	exit 1
fi

info "📦 2/7 - Instalando actualizaciones del sistema y kernel (APT)..."
upgrade_ok=1
critical "apt-get full-upgrade" apt-get "${APT_OPTS[@]}" full-upgrade -y || upgrade_ok=0

if command -v snap >/dev/null; then
	info "🔄 3/7 - Actualizando paquetes Snap..."
	run "snap refresh" sudo snap refresh
else
	info "⏭️  3/7 - Snap no está instalado. Omitiendo..."
fi

if command -v flatpak >/dev/null; then
	info "📦 4/7 - Actualizando paquetes Flatpak..."
	run "flatpak update" flatpak update -y
else
	info "⏭️  4/7 - Flatpak no está instalado. Omitiendo..."
fi

if command -v fwupdmgr >/dev/null; then
	info "🔌 5/7 - Buscando actualizaciones de firmware..."
	sudo fwupdmgr refresh --force >/dev/null 2>&1
	sudo fwupdmgr get-updates >/dev/null 2>&1
	case $? in
	0)
		if critical "fwupdmgr update" fwupdmgr update -y --no-reboot-check; then
			FW_UPDATED=1
		fi
		;;
	2) info "   El firmware está al día (o no hay dispositivos compatibles)." ;;
	*) warn "   No se pudo consultar el firmware. Omitiendo..." ;;
	esac
else
	info "⏭️  5/7 - fwupd no está instalado. Omitiendo..."
fi

# ---------- Limpieza ----------
if ((upgrade_ok)); then
	info "🧹 6/7 - Eliminando paquetes huérfanos y caché (APT)..."
	critical "apt-get autoremove" apt-get "${APT_OPTS[@]}" autoremove --purge -y
	run "apt-get clean" sudo apt-get "${APT_OPTS[@]}" clean
else
	warn "⏭️  6/7 - Omitido: la actualización de APT falló y no conviene quitar paquetes."
fi

if command -v flatpak >/dev/null; then
	info "🧹 7/7 - Eliminando runtimes sin uso (Flatpak)..."
	run "flatpak remove --unused" flatpak remove --unused -y
else
	info "⏭️  7/7 - Flatpak no está instalado. Omitiendo limpieza..."
fi

# ---------- Resumen ----------
echo
if ((${#FAILED[@]} > 0)); then
	warn "⚠️  Terminó con errores en: ${FAILED[*]}"
	status=1
else
	printf '%s✅ ¡Sistema actualizado y limpio!%s\n' "$GREEN" "$NC"
	status=0
fi

if [[ -f /run/reboot-required ]] || ((FW_UPDATED)); then
	echo
	warn "⚠️  Se recomienda reiniciar el sistema."
	if [[ -f /run/reboot-required.pkgs ]]; then
		warn "   Paquetes que lo requieren:"
		sort -u /run/reboot-required.pkgs | sed 's/^/   • /'
	fi
	if ((FW_UPDATED)); then
		warn "   Se actualizó firmware: algunos dispositivos lo aplican durante el reinicio."
	fi
fi

echo
check_new_release

exit "$status"
